		Asset.AddEntry_String( "raiseSound", "fly_generic_raise_npc" ).SetTitle( "Raise" ).SetToolTip( "Sound alias played when the weapon is pulled out. Heard by everyone else; the (Player) field is what the shooter hears." );
		Asset.AddEntry_String( "raiseSoundPlayer", "fly_generic_raise_plr" ).SetTitle( "Raise (Player)" ).SetToolTip( "Sound alias the shooter hears when the weapon is pulled out." );
		Asset.AddEntry_String( "firstRaiseSound", "fly_generic_first_raise_npc" ).SetTitle( "First Raise" ).SetToolTip( "Sound alias played the first time the weapon is pulled out. Heard by everyone else; the (Player) field is what the shooter hears." );
		Asset.AddEntry_String( "firstRaiseSoundPlayer", "fly_generic_first_raise_plr" ).SetTitle( "First Raise (Player)" ).SetToolTip( "Sound alias the shooter hears the first time the weapon is pulled out." );
		Asset.AddEntry_String( "adsRaiseSoundPlayer", "fly_generic_ads_plr" ).SetTitle( "ADS Raise Player" ).SetToolTip( "Sound alias the shooter hears when the weapon is raised to aim down sights." );
		Asset.AddEntry_String( "adsLowerSoundPlayer", "fly_generic_ads_lower_plr" ).SetTitle( "ADS Lower Player" ).SetToolTip( "Sound alias the shooter hears when the weapon is lowered out of aim down sights." );
		Asset.AddEntry_String( "putawaySound", "fly_generic_down_npc" ).SetTitle( "Put Away" ).SetToolTip( "Sound alias played when the weapon is put away. Heard by everyone else; the (Player) field is what the shooter hears." );
		Asset.AddEntry_String( "putawaySoundPlayer", "fly_generic_down_plr" ).SetTitle( "Put Away (Player)" ).SetToolTip( "Sound alias the shooter hears when the weapon is put away." );
		Asset.AddEntry_String( "shellCasing", "" ).SetTitle( "Shell Casing" ).SetToolTip( "Sound alias played for the shell casings hitting the ground. Heard by everyone else; the (Player) field is what the shooter hears." );
