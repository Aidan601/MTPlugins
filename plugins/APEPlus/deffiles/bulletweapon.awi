		Asset.AddEntry_AssetCombo( "fireAnim", "xanim" ).SetTitle( "Fire" ).SetHints( "NOWARNINGS" ).SetToolTip( "First-person animation played for each shot fired from the hip." );
		Asset.AddEntry_AssetCombo( "lastShotAnim", "xanim" ).SetTitle( "Last Shot" ).SetHints( "NOWARNINGS" ).SetToolTip( "First-person animation played for the shot that empties the clip. Empty uses Fire." );
		Asset.AddEntry_AssetCombo( "rechamberAnim", "xanim" ).SetTitle( "Rechamber" ).SetHints( "NOWARNINGS" ).SetToolTip( "First-person animation played when the weapon rechambers between shots (bolt-action rifles, pump shotguns)." );
		Asset.AddEntry_AssetCombo( "reloadAnim", "xanim" ).SetTitle( "Reload" ).SetHints( "NOWARNINGS" ).SetToolTip( "First-person animation played for a reload with rounds still in the clip; scaled to the Reload time." );
		Asset.AddEntry_AssetCombo( "reloadEmptyAnim", "xanim" ).SetTitle( "Reload Empty Anim" ).SetHints( "NOWARNINGS" ).SetToolTip( "First-person animation played for a reload with an empty clip; scaled to the Reload Empty time." );
