/* base-style: plastique
   icon-recolor: #a6e3a1 #14201a
   Generated by tools/make_themes.py
   palette: bg=#14201a panel=#1a2a22 base=#0f1813 alt=#14201a border=#2c4436 text=#dbe9df dim=#95a39a disabled=#606c65 accent=#8fd14f accent2=#a3d96f sel=#3f7a2a seltext=#ffffff hover=#28342e button=#21332a buttonhover=#304238 buttonpress=#18261e tip=#24342b tiptext=#dbe9df handle=#41584a handlehover=#586d60 mark=#000000 icons=#a6e3a1 */

QWidget { background-color: #14201a; color: #dbe9df; selection-background-color: #3f7a2a; selection-color: #ffffff; }
QWidget:disabled { color: #606c65; }
QMainWindow, QDialog { background-color: #14201a; }
QMainWindow::separator { background-color: #2c4436; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #8fd14f; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #2c4436; background-color: #2c4436; }
QToolTip { background-color: #24342b; color: #dbe9df; border: 1px solid #2c4436; padding: 3px 5px; }

QMenuBar { background-color: #1a2a22; border-bottom: 1px solid #2c4436; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #28342e; }
QMenuBar::item:pressed { background-color: #3f7a2a; color: #ffffff; }
QMenu { background-color: #1a2a22; border: 1px solid #2c4436; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #3f7a2a; color: #ffffff; }
QMenu::item:disabled { color: #606c65; }
QMenu::separator { height: 1px; background-color: #2c4436; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/forest/check-dim.png); }
QMenu::right-arrow { image: url(images/forest/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #1a2a22; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #2c4436; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #2c4436; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #28342e; border-color: #2c4436; }
QToolButton:pressed { background-color: #18261e; }
QToolButton:checked { background-color: #3f7a2a; border-color: #8fd14f; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/forest/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #dbe9df; titlebar-close-icon: url(images/forest/close.png); titlebar-normal-icon: url(images/forest/float.png); }
QDockWidget::title { background-color: #1a2a22; padding: 4px 6px; border-bottom: 1px solid #2c4436; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #28342e; border-color: #2c4436; }
QTabWidget::pane { border: 1px solid #2c4436; top: -1px; background-color: #14201a; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #1a2a22; color: #95a39a; border: 1px solid #2c4436; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #14201a; color: #dbe9df; }
QTabBar::tab:top:selected { border-top: 2px solid #8fd14f; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #8fd14f; }
QTabBar::tab:hover:!selected { background-color: #28342e; color: #dbe9df; }
QTabBar::close-button { image: url(images/forest/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/forest/close-hover.png); }
QTabBar QToolButton { background-color: #1a2a22; border: 1px solid #2c4436; }
QTabBar QToolButton::left-arrow { image: url(images/forest/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/forest/arrow-right.png); }

QPushButton { background-color: #21332a; color: #dbe9df; border: 1px solid #2c4436; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #304238; border-color: #8fd14f; }
QPushButton:pressed { background-color: #18261e; }
QPushButton:checked { background-color: #3f7a2a; color: #ffffff; border-color: #8fd14f; }
QPushButton:default { border-color: #8fd14f; }
QPushButton:disabled { color: #606c65; background-color: #14201a; border-color: #2c4436; }
QPushButton::menu-indicator { image: url(images/forest/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #0f1813; color: #dbe9df; border: 1px solid #2c4436; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #8fd14f; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #14201a; color: #606c65; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #21332a; border-left: 1px solid #2c4436; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #304238; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #18261e; }
QAbstractSpinBox::up-arrow { image: url(images/forest/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/forest/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #21332a; color: #dbe9df; border: 1px solid #2c4436; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #0f1813; }
QComboBox:hover { border-color: #8fd14f; }
QComboBox:on { border-color: #8fd14f; }
QComboBox:disabled { color: #606c65; background-color: #14201a; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #2c4436; }
QComboBox::down-arrow { image: url(images/forest/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #0f1813; border: 1px solid #2c4436; selection-background-color: #3f7a2a; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #0f1813; border: 1px solid #41584a; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #8fd14f; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #8fd14f; border-color: #8fd14f; image: url(images/forest/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #8fd14f; border-color: #8fd14f; image: url(images/forest/partial.png); }
QRadioButton::indicator:checked { background-color: #8fd14f; border-color: #8fd14f; image: url(images/forest/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #14201a; border-color: #2c4436; }
QCheckBox::indicator:checked:disabled { background-color: #2c4436; }

QGroupBox { border: 1px solid #2c4436; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #95a39a; }

QAbstractItemView { background-color: #0f1813; alternate-background-color: #14201a; color: #dbe9df; border: 1px solid #2c4436; outline: 0; }
QAbstractItemView::item:hover { background-color: #28342e; }
QAbstractItemView::item:selected { background-color: #3f7a2a; color: #ffffff; }
QAbstractItemView:disabled { color: #606c65; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/forest/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/forest/arrow-down.png); }
QHeaderView { background-color: #1a2a22; }
QHeaderView::section { background-color: #1a2a22; color: #95a39a; padding: 3px 6px; border: none; border-right: 1px solid #2c4436; border-bottom: 1px solid #2c4436; }
QHeaderView::section:hover { background-color: #28342e; color: #dbe9df; }
QTableCornerButton::section { background-color: #1a2a22; border: none; border-right: 1px solid #2c4436; border-bottom: 1px solid #2c4436; }

QScrollBar:vertical { background-color: #14201a; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #14201a; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #41584a; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #586d60; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #14201a; }

QSlider::groove:horizontal { height: 4px; background-color: #2c4436; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #2c4436; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #8fd14f; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #8fd14f; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #dbe9df; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #dbe9df; }
QSlider::handle:hover { background-color: #a3d96f; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #0f1813; border: 1px solid #2c4436; border-radius: 2px; text-align: center; color: #dbe9df; }
QProgressBar::chunk { background-color: #8fd14f; }
QSplitter::handle { background-color: #14201a; }
QSplitter::handle:hover { background-color: #8fd14f; }
QStatusBar { background-color: #1a2a22; border-top: 1px solid #2c4436; color: #95a39a; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
