/* base-style: plastique
   icon-recolor: #ffc4ad #4a5160
   Generated by tools/make_themes.py
   palette: bg=#4a5160 panel=#545c6c base=#3e4450 alt=#484f5d border=#6b7486 text=#eef0f5 dim=#b5b8c1 disabled=#888d99 accent=#ff8c6b accent2=#ffa186 sel=#c4573b seltext=#ffffff hover=#5a616f button=#5b6475 buttonhover=#676f7f buttonpress=#4c5462 tip=#5c6373 tiptext=#eef0f5 handle=#7b8393 handlehover=#8c93a2 mark=#000000 icons=#ffc4ad */

QWidget { background-color: #4a5160; color: #eef0f5; selection-background-color: #c4573b; selection-color: #ffffff; }
QWidget:disabled { color: #888d99; }
QMainWindow, QDialog { background-color: #4a5160; }
QMainWindow::separator { background-color: #6b7486; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #ff8c6b; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #6b7486; background-color: #6b7486; }
QToolTip { background-color: #5c6373; color: #eef0f5; border: 1px solid #6b7486; padding: 3px 5px; }

QMenuBar { background-color: #545c6c; border-bottom: 1px solid #6b7486; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #5a616f; }
QMenuBar::item:pressed { background-color: #c4573b; color: #ffffff; }
QMenu { background-color: #545c6c; border: 1px solid #6b7486; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #c4573b; color: #ffffff; }
QMenu::item:disabled { color: #888d99; }
QMenu::separator { height: 1px; background-color: #6b7486; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/slate/check-dim.png); }
QMenu::right-arrow { image: url(images/slate/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #545c6c; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #6b7486; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #6b7486; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #5a616f; border-color: #6b7486; }
QToolButton:pressed { background-color: #4c5462; }
QToolButton:checked { background-color: #c4573b; border-color: #ff8c6b; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/slate/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #eef0f5; titlebar-close-icon: url(images/slate/close.png); titlebar-normal-icon: url(images/slate/float.png); }
QDockWidget::title { background-color: #545c6c; padding: 4px 6px; border-bottom: 1px solid #6b7486; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #5a616f; border-color: #6b7486; }
QTabWidget::pane { border: 1px solid #6b7486; top: -1px; background-color: #4a5160; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #545c6c; color: #b5b8c1; border: 1px solid #6b7486; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #4a5160; color: #eef0f5; }
QTabBar::tab:top:selected { border-top: 2px solid #ff8c6b; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #ff8c6b; }
QTabBar::tab:hover:!selected { background-color: #5a616f; color: #eef0f5; }
QTabBar::close-button { image: url(images/slate/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/slate/close-hover.png); }
QTabBar QToolButton { background-color: #545c6c; border: 1px solid #6b7486; }
QTabBar QToolButton::left-arrow { image: url(images/slate/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/slate/arrow-right.png); }

QPushButton { background-color: #5b6475; color: #eef0f5; border: 1px solid #6b7486; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #676f7f; border-color: #ff8c6b; }
QPushButton:pressed { background-color: #4c5462; }
QPushButton:checked { background-color: #c4573b; color: #ffffff; border-color: #ff8c6b; }
QPushButton:default { border-color: #ff8c6b; }
QPushButton:disabled { color: #888d99; background-color: #4a5160; border-color: #6b7486; }
QPushButton::menu-indicator { image: url(images/slate/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #3e4450; color: #eef0f5; border: 1px solid #6b7486; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #ff8c6b; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #4a5160; color: #888d99; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #5b6475; border-left: 1px solid #6b7486; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #676f7f; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #4c5462; }
QAbstractSpinBox::up-arrow { image: url(images/slate/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/slate/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #5b6475; color: #eef0f5; border: 1px solid #6b7486; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #3e4450; }
QComboBox:hover { border-color: #ff8c6b; }
QComboBox:on { border-color: #ff8c6b; }
QComboBox:disabled { color: #888d99; background-color: #4a5160; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #6b7486; }
QComboBox::down-arrow { image: url(images/slate/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #3e4450; border: 1px solid #6b7486; selection-background-color: #c4573b; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #3e4450; border: 1px solid #7b8393; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #ff8c6b; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #ff8c6b; border-color: #ff8c6b; image: url(images/slate/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #ff8c6b; border-color: #ff8c6b; image: url(images/slate/partial.png); }
QRadioButton::indicator:checked { background-color: #ff8c6b; border-color: #ff8c6b; image: url(images/slate/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #4a5160; border-color: #6b7486; }
QCheckBox::indicator:checked:disabled { background-color: #6b7486; }

QGroupBox { border: 1px solid #6b7486; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #b5b8c1; }

QAbstractItemView { background-color: #3e4450; alternate-background-color: #484f5d; color: #eef0f5; border: 1px solid #6b7486; outline: 0; }
QAbstractItemView::item:hover { background-color: #5a616f; }
QAbstractItemView::item:selected { background-color: #c4573b; color: #ffffff; }
QAbstractItemView:disabled { color: #888d99; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/slate/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/slate/arrow-down.png); }
QHeaderView { background-color: #545c6c; }
QHeaderView::section { background-color: #545c6c; color: #b5b8c1; padding: 3px 6px; border: none; border-right: 1px solid #6b7486; border-bottom: 1px solid #6b7486; }
QHeaderView::section:hover { background-color: #5a616f; color: #eef0f5; }
QTableCornerButton::section { background-color: #545c6c; border: none; border-right: 1px solid #6b7486; border-bottom: 1px solid #6b7486; }

QScrollBar:vertical { background-color: #4a5160; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #4a5160; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #7b8393; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #8c93a2; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #4a5160; }

QSlider::groove:horizontal { height: 4px; background-color: #6b7486; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #6b7486; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #ff8c6b; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #ff8c6b; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #eef0f5; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #eef0f5; }
QSlider::handle:hover { background-color: #ffa186; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #3e4450; border: 1px solid #6b7486; border-radius: 2px; text-align: center; color: #eef0f5; }
QProgressBar::chunk { background-color: #ff8c6b; }
QSplitter::handle { background-color: #4a5160; }
QSplitter::handle:hover { background-color: #ff8c6b; }
QStatusBar { background-color: #545c6c; border-top: 1px solid #6b7486; color: #b5b8c1; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
