/* base-style: plastique
   icon-recolor: #e6e6e6 #303030
   Generated by tools/make_themes.py
   palette: bg=#303030 panel=#282828 base=#1d1d1d alt=#2b2b2b border=#3a3a3a text=#e6e6e6 dim=#a6a6a6 disabled=#707070 accent=#4772b3 accent2=#5680c2 sel=#4772b3 seltext=#ffffff hover=#3d3d3d button=#545454 buttonhover=#656565 buttonpress=#4772b3 tip=#181818 tiptext=#e6e6e6 handle=#4d4d4d handlehover=#6b6b6b mark=#ffffff icons=#e6e6e6 */

QWidget { background-color: #303030; color: #e6e6e6; selection-background-color: #4772b3; selection-color: #ffffff; }
QWidget:disabled { color: #707070; }
QMainWindow, QDialog { background-color: #303030; }
QMainWindow::separator { background-color: #3a3a3a; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #4772b3; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #3a3a3a; background-color: #3a3a3a; }
QToolTip { background-color: #181818; color: #e6e6e6; border: 1px solid #3a3a3a; padding: 3px 5px; }

QMenuBar { background-color: #282828; border-bottom: 1px solid #3a3a3a; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #3d3d3d; }
QMenuBar::item:pressed { background-color: #4772b3; color: #ffffff; }
QMenu { background-color: #282828; border: 1px solid #3a3a3a; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #4772b3; color: #ffffff; }
QMenu::item:disabled { color: #707070; }
QMenu::separator { height: 1px; background-color: #3a3a3a; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/blender/check-dim.png); }
QMenu::right-arrow { image: url(images/blender/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #282828; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #3a3a3a; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #3a3a3a; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #3d3d3d; border-color: #3a3a3a; }
QToolButton:pressed { background-color: #4772b3; }
QToolButton:checked { background-color: #4772b3; border-color: #4772b3; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/blender/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #e6e6e6; titlebar-close-icon: url(images/blender/close.png); titlebar-normal-icon: url(images/blender/float.png); }
QDockWidget::title { background-color: #282828; padding: 4px 6px; border-bottom: 1px solid #3a3a3a; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #3d3d3d; border-color: #3a3a3a; }
QTabWidget::pane { border: 1px solid #3a3a3a; top: -1px; background-color: #303030; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #282828; color: #a6a6a6; border: 1px solid #3a3a3a; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #303030; color: #e6e6e6; }
QTabBar::tab:top:selected { border-top: 2px solid #4772b3; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #4772b3; }
QTabBar::tab:hover:!selected { background-color: #3d3d3d; color: #e6e6e6; }
QTabBar::close-button { image: url(images/blender/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/blender/close-hover.png); }
QTabBar QToolButton { background-color: #282828; border: 1px solid #3a3a3a; }
QTabBar QToolButton::left-arrow { image: url(images/blender/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/blender/arrow-right.png); }

QPushButton { background-color: #545454; color: #e6e6e6; border: 1px solid #3a3a3a; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #656565; border-color: #4772b3; }
QPushButton:pressed { background-color: #4772b3; }
QPushButton:checked { background-color: #4772b3; color: #ffffff; border-color: #4772b3; }
QPushButton:default { border-color: #4772b3; }
QPushButton:disabled { color: #707070; background-color: #303030; border-color: #3a3a3a; }
QPushButton::menu-indicator { image: url(images/blender/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #1d1d1d; color: #e6e6e6; border: 1px solid #3a3a3a; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #4772b3; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #303030; color: #707070; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #545454; border-left: 1px solid #3a3a3a; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #656565; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #4772b3; }
QAbstractSpinBox::up-arrow { image: url(images/blender/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/blender/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #545454; color: #e6e6e6; border: 1px solid #3a3a3a; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #1d1d1d; }
QComboBox:hover { border-color: #4772b3; }
QComboBox:on { border-color: #4772b3; }
QComboBox:disabled { color: #707070; background-color: #303030; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #3a3a3a; }
QComboBox::down-arrow { image: url(images/blender/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #1d1d1d; border: 1px solid #3a3a3a; selection-background-color: #4772b3; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #1d1d1d; border: 1px solid #4d4d4d; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #4772b3; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #4772b3; border-color: #4772b3; image: url(images/blender/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #4772b3; border-color: #4772b3; image: url(images/blender/partial.png); }
QRadioButton::indicator:checked { background-color: #4772b3; border-color: #4772b3; image: url(images/blender/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #303030; border-color: #3a3a3a; }
QCheckBox::indicator:checked:disabled { background-color: #3a3a3a; }

QGroupBox { border: 1px solid #3a3a3a; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #a6a6a6; }

QAbstractItemView { background-color: #1d1d1d; alternate-background-color: #2b2b2b; color: #e6e6e6; border: 1px solid #3a3a3a; outline: 0; }
QAbstractItemView::item:hover { background-color: #3d3d3d; }
QAbstractItemView::item:selected { background-color: #4772b3; color: #ffffff; }
QAbstractItemView:disabled { color: #707070; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/blender/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/blender/arrow-down.png); }
QHeaderView { background-color: #282828; }
QHeaderView::section { background-color: #282828; color: #a6a6a6; padding: 3px 6px; border: none; border-right: 1px solid #3a3a3a; border-bottom: 1px solid #3a3a3a; }
QHeaderView::section:hover { background-color: #3d3d3d; color: #e6e6e6; }
QTableCornerButton::section { background-color: #282828; border: none; border-right: 1px solid #3a3a3a; border-bottom: 1px solid #3a3a3a; }

QScrollBar:vertical { background-color: #303030; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #303030; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #4d4d4d; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #6b6b6b; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #303030; }

QSlider::groove:horizontal { height: 4px; background-color: #3a3a3a; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #3a3a3a; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #4772b3; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #4772b3; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #e6e6e6; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #e6e6e6; }
QSlider::handle:hover { background-color: #5680c2; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #1d1d1d; border: 1px solid #3a3a3a; border-radius: 2px; text-align: center; color: #e6e6e6; }
QProgressBar::chunk { background-color: #4772b3; }
QSplitter::handle { background-color: #303030; }
QSplitter::handle:hover { background-color: #4772b3; }
QStatusBar { background-color: #282828; border-top: 1px solid #3a3a3a; color: #a6a6a6; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }

QPushButton { background-color: #545454; border: 1px solid #3a3a3a; border-radius: 4px; padding: 3px 12px; }
QPushButton:hover { background-color: #656565; border-color: #3a3a3a; }
QPushButton:pressed, QPushButton:checked { background-color: #4772b3; border-color: #4772b3; color: #ffffff; }
QPushButton:default { border-color: #4772b3; }
QPushButton:disabled { background-color: #3d3d3d; }
QToolButton { border-radius: 4px; }
QToolButton:hover { background-color: #545454; border-color: #545454; }
QToolButton:checked { background-color: #4772b3; border-color: #4772b3; }
QLineEdit, QTextEdit, QPlainTextEdit { background-color: #1d1d1d; border: 1px solid #1d1d1d; border-radius: 4px; }
QAbstractSpinBox { background-color: #545454; border: 1px solid #3a3a3a; border-radius: 4px; }
QAbstractSpinBox:focus { background-color: #1d1d1d; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { background-color: transparent; border-left: none; }
QComboBox { background-color: #282828; border: 1px solid #3a3a3a; border-radius: 4px; }
QComboBox::drop-down { border-left: none; }
QMenuBar { background-color: #282828; border-bottom: none; }
QMenu { background-color: #181818; border: 1px solid #282828; }
QMenu::item:selected { background-color: #4772b3; }
QMenu::separator { background-color: #2d2d2d; }
QTabBar::tab { background-color: #1d1d1d; border-color: #1d1d1d; color: #9c9c9c; }
QTabBar::tab:top { border-top-left-radius: 4px; border-top-right-radius: 4px; }
QTabBar::tab:selected { background-color: #303030; border-color: #303030; color: #ffffff; }
QTabBar::tab:top:selected { border-top: 1px solid #303030; }
QTabBar::tab:bottom:selected { border-bottom: 1px solid #303030; }
QAbstractItemView { background-color: #282828; alternate-background-color: #2b2b2b; }
QAbstractItemView::item:selected { background-color: #334d80; color: #ffffff; }
QCheckBox::indicator, QAbstractItemView::indicator { background-color: #545454; border: 1px solid #545454; border-radius: 3px; }
QRadioButton::indicator { background-color: #545454; border: 1px solid #545454; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { background-color: #656565; border-color: #656565; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked, QRadioButton::indicator:checked { background-color: #4772b3; border-color: #4772b3; }
QGroupBox { background-color: #3d3d3d; border: none; border-radius: 4px; margin-top: 18px; padding-top: 6px; }
QGroupBox::title { color: #e6e6e6; left: 4px; }
QHeaderView::section { background-color: #303030; color: #e6e6e6; }
QSlider::groove:horizontal { height: 6px; background-color: #545454; border-radius: 3px; }
QSlider::groove:vertical { width: 6px; background-color: #545454; border-radius: 3px; }
QSlider::sub-page:horizontal, QSlider::add-page:vertical { border-radius: 3px; }
QSlider::handle:horizontal, QSlider::handle:vertical { background-color: #d9d9d9; }
QProgressBar { background-color: #545454; border: none; border-radius: 4px; }
QProgressBar::chunk { border-radius: 4px; }
QScrollBar:vertical { width: 10px; }
QScrollBar:horizontal { height: 10px; }
QScrollBar::handle { border-radius: 4px; }
