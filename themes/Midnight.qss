/* base-style: plastique
   icon-recolor: #7ee3d6 #0d1424
   Generated by tools/make_themes.py
   palette: bg=#0d1424 panel=#131c31 base=#090e1a alt=#0e1424 border=#26355a text=#d3ddf2 dim=#8e97aa disabled=#586072 accent=#2fc4b2 accent2=#54cfc0 sel=#17736a seltext=#ffffff hover=#212839 button=#1b2742 buttonhover=#2a3650 buttonpress=#121a2e tip=#1d263b tiptext=#d3ddf2 handle=#3b496c handlehover=#515f80 mark=#000000 icons=#7ee3d6 */

QWidget { background-color: #0d1424; color: #d3ddf2; selection-background-color: #17736a; selection-color: #ffffff; }
QWidget:disabled { color: #586072; }
QMainWindow, QDialog { background-color: #0d1424; }
QMainWindow::separator { background-color: #26355a; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #2fc4b2; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #26355a; background-color: #26355a; }
QToolTip { background-color: #1d263b; color: #d3ddf2; border: 1px solid #26355a; padding: 3px 5px; }

QMenuBar { background-color: #131c31; border-bottom: 1px solid #26355a; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #212839; }
QMenuBar::item:pressed { background-color: #17736a; color: #ffffff; }
QMenu { background-color: #131c31; border: 1px solid #26355a; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #17736a; color: #ffffff; }
QMenu::item:disabled { color: #586072; }
QMenu::separator { height: 1px; background-color: #26355a; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/midnight/check-dim.png); }
QMenu::right-arrow { image: url(images/midnight/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #131c31; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #26355a; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #26355a; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #212839; border-color: #26355a; }
QToolButton:pressed { background-color: #121a2e; }
QToolButton:checked { background-color: #17736a; border-color: #2fc4b2; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/midnight/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #d3ddf2; titlebar-close-icon: url(images/midnight/close.png); titlebar-normal-icon: url(images/midnight/float.png); }
QDockWidget::title { background-color: #131c31; padding: 4px 6px; border-bottom: 1px solid #26355a; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #212839; border-color: #26355a; }
QTabWidget::pane { border: 1px solid #26355a; top: -1px; background-color: #0d1424; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #131c31; color: #8e97aa; border: 1px solid #26355a; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #0d1424; color: #d3ddf2; }
QTabBar::tab:top:selected { border-top: 2px solid #2fc4b2; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #2fc4b2; }
QTabBar::tab:hover:!selected { background-color: #212839; color: #d3ddf2; }
QTabBar::close-button { image: url(images/midnight/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/midnight/close-hover.png); }
QTabBar QToolButton { background-color: #131c31; border: 1px solid #26355a; }
QTabBar QToolButton::left-arrow { image: url(images/midnight/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/midnight/arrow-right.png); }

QPushButton { background-color: #1b2742; color: #d3ddf2; border: 1px solid #26355a; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #2a3650; border-color: #2fc4b2; }
QPushButton:pressed { background-color: #121a2e; }
QPushButton:checked { background-color: #17736a; color: #ffffff; border-color: #2fc4b2; }
QPushButton:default { border-color: #2fc4b2; }
QPushButton:disabled { color: #586072; background-color: #0d1424; border-color: #26355a; }
QPushButton::menu-indicator { image: url(images/midnight/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #090e1a; color: #d3ddf2; border: 1px solid #26355a; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #2fc4b2; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #0d1424; color: #586072; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #1b2742; border-left: 1px solid #26355a; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #2a3650; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #121a2e; }
QAbstractSpinBox::up-arrow { image: url(images/midnight/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/midnight/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #1b2742; color: #d3ddf2; border: 1px solid #26355a; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #090e1a; }
QComboBox:hover { border-color: #2fc4b2; }
QComboBox:on { border-color: #2fc4b2; }
QComboBox:disabled { color: #586072; background-color: #0d1424; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #26355a; }
QComboBox::down-arrow { image: url(images/midnight/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #090e1a; border: 1px solid #26355a; selection-background-color: #17736a; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #090e1a; border: 1px solid #3b496c; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #2fc4b2; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #2fc4b2; border-color: #2fc4b2; image: url(images/midnight/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #2fc4b2; border-color: #2fc4b2; image: url(images/midnight/partial.png); }
QRadioButton::indicator:checked { background-color: #2fc4b2; border-color: #2fc4b2; image: url(images/midnight/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #0d1424; border-color: #26355a; }
QCheckBox::indicator:checked:disabled { background-color: #26355a; }

QGroupBox { border: 1px solid #26355a; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #8e97aa; }

QAbstractItemView { background-color: #090e1a; alternate-background-color: #0e1424; color: #d3ddf2; border: 1px solid #26355a; outline: 0; }
QAbstractItemView::item:hover { background-color: #212839; }
QAbstractItemView::item:selected { background-color: #17736a; color: #ffffff; }
QAbstractItemView:disabled { color: #586072; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/midnight/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/midnight/arrow-down.png); }
QHeaderView { background-color: #131c31; }
QHeaderView::section { background-color: #131c31; color: #8e97aa; padding: 3px 6px; border: none; border-right: 1px solid #26355a; border-bottom: 1px solid #26355a; }
QHeaderView::section:hover { background-color: #212839; color: #d3ddf2; }
QTableCornerButton::section { background-color: #131c31; border: none; border-right: 1px solid #26355a; border-bottom: 1px solid #26355a; }

QScrollBar:vertical { background-color: #0d1424; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #0d1424; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #3b496c; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #515f80; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #0d1424; }

QSlider::groove:horizontal { height: 4px; background-color: #26355a; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #26355a; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #2fc4b2; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #2fc4b2; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #d3ddf2; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #d3ddf2; }
QSlider::handle:hover { background-color: #54cfc0; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #090e1a; border: 1px solid #26355a; border-radius: 2px; text-align: center; color: #d3ddf2; }
QProgressBar::chunk { background-color: #2fc4b2; }
QSplitter::handle { background-color: #0d1424; }
QSplitter::handle:hover { background-color: #2fc4b2; }
QStatusBar { background-color: #131c31; border-top: 1px solid #26355a; color: #8e97aa; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
