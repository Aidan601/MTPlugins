/* base-style: plastique
   Generated by tools/make_themes.py
   palette: bg=#323232 panel=#323232 base=#242424 alt=#2b2b2b border=#1e1e1e text=#b1b1b1 dim=#b1b1b1 disabled=#505050 accent=#ffa02f accent2=#ffaa00 sel=#d7801a seltext=#000000 hover=#3d3d3d button=#4e4e4e buttonhover=#565656 buttonpress=#292929 tip=#ffa02f tiptext=#000000 handle=#b1b1b1 handlehover=#ffa02f mark=#000000 icons=#b1b1b1 */

QWidget { background-color: #323232; color: #b1b1b1; selection-background-color: #d7801a; selection-color: #000000; }
QWidget:disabled { color: #505050; }
QMainWindow, QDialog { background-color: #323232; }
QMainWindow::separator { background-color: #1e1e1e; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #ffa02f; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #1e1e1e; background-color: #1e1e1e; }
QToolTip { background-color: #ffa02f; color: #000000; border: 1px solid #1e1e1e; padding: 3px 5px; }

QMenuBar { background-color: #323232; border-bottom: 1px solid #1e1e1e; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #3d3d3d; }
QMenuBar::item:pressed { background-color: #d7801a; color: #000000; }
QMenu { background-color: #323232; border: 1px solid #1e1e1e; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #d7801a; color: #000000; }
QMenu::item:disabled { color: #505050; }
QMenu::separator { height: 1px; background-color: #1e1e1e; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/treyarch/check-dim.png); }
QMenu::right-arrow { image: url(images/treyarch/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #323232; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #1e1e1e; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #1e1e1e; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #3d3d3d; border-color: #1e1e1e; }
QToolButton:pressed { background-color: #292929; }
QToolButton:checked { background-color: #d7801a; border-color: #ffa02f; color: #000000; }
QToolButton::menu-indicator { image: url(images/treyarch/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #b1b1b1; titlebar-close-icon: url(images/treyarch/close.png); titlebar-normal-icon: url(images/treyarch/float.png); }
QDockWidget::title { background-color: #323232; padding: 4px 6px; border-bottom: 1px solid #1e1e1e; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #3d3d3d; border-color: #1e1e1e; }
QTabWidget::pane { border: 1px solid #1e1e1e; top: -1px; background-color: #323232; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #323232; color: #b1b1b1; border: 1px solid #1e1e1e; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #323232; color: #b1b1b1; }
QTabBar::tab:top:selected { border-top: 2px solid #ffa02f; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #ffa02f; }
QTabBar::tab:hover:!selected { background-color: #3d3d3d; color: #b1b1b1; }
QTabBar::close-button { image: url(images/treyarch/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/treyarch/close-hover.png); }
QTabBar QToolButton { background-color: #323232; border: 1px solid #1e1e1e; }
QTabBar QToolButton::left-arrow { image: url(images/treyarch/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/treyarch/arrow-right.png); }

QPushButton { background-color: #4e4e4e; color: #b1b1b1; border: 1px solid #1e1e1e; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #565656; border-color: #ffa02f; }
QPushButton:pressed { background-color: #292929; }
QPushButton:checked { background-color: #d7801a; color: #000000; border-color: #ffa02f; }
QPushButton:default { border-color: #ffa02f; }
QPushButton:disabled { color: #505050; background-color: #323232; border-color: #1e1e1e; }
QPushButton::menu-indicator { image: url(images/treyarch/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #242424; color: #b1b1b1; border: 1px solid #1e1e1e; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #ffa02f; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #323232; color: #505050; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #4e4e4e; border-left: 1px solid #1e1e1e; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #565656; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #292929; }
QAbstractSpinBox::up-arrow { image: url(images/treyarch/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/treyarch/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #4e4e4e; color: #b1b1b1; border: 1px solid #1e1e1e; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #242424; }
QComboBox:hover { border-color: #ffa02f; }
QComboBox:on { border-color: #ffa02f; }
QComboBox:disabled { color: #505050; background-color: #323232; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #1e1e1e; }
QComboBox::down-arrow { image: url(images/treyarch/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #242424; border: 1px solid #1e1e1e; selection-background-color: #d7801a; selection-color: #000000; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #242424; border: 1px solid #b1b1b1; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #ffa02f; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #ffa02f; border-color: #ffa02f; image: url(images/treyarch/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #ffa02f; border-color: #ffa02f; image: url(images/treyarch/partial.png); }
QRadioButton::indicator:checked { background-color: #ffa02f; border-color: #ffa02f; image: url(images/treyarch/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #323232; border-color: #1e1e1e; }
QCheckBox::indicator:checked:disabled { background-color: #1e1e1e; }

QGroupBox { border: 1px solid #1e1e1e; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #b1b1b1; }

QAbstractItemView { background-color: #242424; alternate-background-color: #2b2b2b; color: #b1b1b1; border: 1px solid #1e1e1e; outline: 0; }
QAbstractItemView::item:hover { background-color: #3d3d3d; }
QAbstractItemView::item:selected { background-color: #d7801a; color: #000000; }
QAbstractItemView:disabled { color: #505050; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/treyarch/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/treyarch/arrow-down.png); }
QHeaderView { background-color: #323232; }
QHeaderView::section { background-color: #323232; color: #b1b1b1; padding: 3px 6px; border: none; border-right: 1px solid #1e1e1e; border-bottom: 1px solid #1e1e1e; }
QHeaderView::section:hover { background-color: #3d3d3d; color: #b1b1b1; }
QTableCornerButton::section { background-color: #323232; border: none; border-right: 1px solid #1e1e1e; border-bottom: 1px solid #1e1e1e; }

QScrollBar:vertical { background-color: #323232; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #323232; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #b1b1b1; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #ffa02f; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #323232; }

QSlider::groove:horizontal { height: 4px; background-color: #1e1e1e; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #1e1e1e; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #ffa02f; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #ffa02f; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #b1b1b1; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #b1b1b1; }
QSlider::handle:hover { background-color: #ffaa00; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #242424; border: 1px solid #1e1e1e; border-radius: 2px; text-align: center; color: #b1b1b1; }
QProgressBar::chunk { background-color: #ffa02f; }
QSplitter::handle { background-color: #323232; }
QSplitter::handle:hover { background-color: #ffa02f; }
QStatusBar { background-color: #323232; border-top: 1px solid #1e1e1e; color: #b1b1b1; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }

QToolTip { border-color: #000000; }
QMenuBar::item { border: 1px solid transparent; }
QMenuBar::item:selected { background: transparent; border-color: #ffaa00; }
QMenuBar::item:pressed { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0.4 #343434, stop:1 #212121); color: #b1b1b1; border-color: #000000; }
QMenu { border-color: #000000; }
QMenu::item:selected { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffa02f, stop:1 #d7801a); color: #000000; }
QMenu::separator { background-color: #424242; }
QMainWindow::separator { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #161616, stop:0.5 #151515, stop:0.6 #212121, stop:1 #343434); }
QMainWindow::separator:hover { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d7801a, stop:0.5 #b56c17, stop:1 #ffa02f); }
QScrollArea { background-color: #212121; }
QToolButton:hover { background-color: transparent; border-color: #ffaa00; }
QToolButton:pressed { background-color: transparent; color: #ffa02f; }
QToolButton:checked { background-color: transparent; border-color: #995500; color: #b1b1b1; }
QDockWidget::title { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #424242, stop:0.5 #242424, stop:1 #323232); }
QDockWidget::close-button, QDockWidget::float-button { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d7801a, stop:0.5 #b56c17, stop:1 #ffa02f); }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #ffa02f; }
QDockWidget::close-button:pressed, QDockWidget::float-button:pressed { background-color: #424242; }
QTabWidget::pane, QTabBar::tab { border-color: #444444; }
QTabBar::tab { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0.4 #343434, stop:1 #212121); color: #b1b1b1; }
QTabBar::tab:selected { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #444444, stop:0.4 #444444, stop:1 #313131); color: #b1b1b1; }
QTabBar::tab:top:selected { border-top-color: #ffaa00; }
QTabBar::tab:bottom:selected { border-bottom-color: #ffaa00; }
QTabBar::tab:hover:!selected { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffaa00, stop:0.1 #ffaa00, stop:0.11 #343434, stop:0.4 #343434, stop:1 #212121); }
QPushButton, QComboBox, QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #565656, stop:0.1 #525252, stop:0.5 #4e4e4e, stop:0.9 #4a4a4a, stop:1 #464646); border-color: #1e1e1e; }
QPushButton:hover, QComboBox:hover { border-color: #ffa02f; }
QPushButton:pressed, QPushButton:checked, QComboBox:on, QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2d2d2d, stop:0.1 #2b2b2b, stop:0.5 #292929, stop:0.9 #282828, stop:1 #252525); color: #ffa02f; }
QPushButton:disabled, QComboBox:disabled { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1d1d1d, stop:0.1 #1b1b1b, stop:0.5 #191919, stop:0.9 #181818, stop:1 #151515); }
QLineEdit, QAbstractSpinBox, QComboBox:editable { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #646464, stop:1 #5d5d5d); border-color: #1e1e1e; }
QTextEdit, QPlainTextEdit { background-color: #242424; }
QAbstractItemView { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #4d4d4d, stop:0.1 #646464, stop:1 #5d5d5d); alternate-background-color: #5d5d5d; }
QAbstractItemView::item:hover, QAbstractItemView::item:selected { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffa02f, stop:1 #d7801a); color: #000000; }
QComboBox QAbstractItemView { border-color: #a9a9a9; selection-background-color: #ffaa00; }
QHeaderView, QTableCornerButton::section { background-color: #505050; }
QHeaderView::section { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #616161, stop:0.5 #505050, stop:0.6 #434343, stop:1 #656565); color: #ffffff; border-color: #6c6c6c; }
QHeaderView::section:hover { color: #ffffff; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { background-color: #323232; border-color: #b1b1b1; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #ffaa00; }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { border-color: #444444; }
QCheckBox:disabled { color: #414141; }
QScrollBar:vertical { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #121212, stop:0.2 #282828, stop:1 #484848); }
QScrollBar:horizontal { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #121212, stop:0.2 #282828, stop:1 #484848); }
QScrollBar::handle:vertical, QScrollBar::handle:vertical:hover { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #ffa02f, stop:0.5 #d7801a, stop:1 #ffa02f); }
QScrollBar::handle:horizontal, QScrollBar::handle:horizontal:hover { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #ffa02f, stop:0.5 #d7801a, stop:1 #ffa02f); }
QSlider::groove:horizontal { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #121212, stop:0.2 #282828, stop:1 #484848); }
QSlider::groove:vertical { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #121212, stop:0.2 #282828, stop:1 #484848); }
QSlider::handle:horizontal, QSlider::handle:vertical, QSlider::handle:hover { background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #d7801a, stop:0.5 #b56c17, stop:1 #ffa02f); }
QProgressBar { border-color: #808080; }
QProgressBar::chunk { background-color: #d7801a; }
