/* base-style: plastique
   icon-pack: icons/Figglebottom
   Generated by tools/make_themes.py
   palette: bg=#231813 panel=#2d201a base=#19110d alt=#211712 border=#4f3b2d text=#f1e3cf dim=#ab9c8b disabled=#70645a accent=#d39c5c accent2=#dfb27d sel=#8c5f30 seltext=#ffffff hover=#372a22 button=#3a2a20 buttonhover=#49372b buttonpress=#2a1e17 tip=#33261e tiptext=#f1e3cf handle=#614b3b handlehover=#79614e mark=#000000 icons=#d9a56a */

QWidget { background-color: #231813; color: #f1e3cf; selection-background-color: #8c5f30; selection-color: #ffffff; }
QWidget:disabled { color: #70645a; }
QMainWindow, QDialog { background-color: #231813; }
QMainWindow::separator { background-color: #4f3b2d; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #d39c5c; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #4f3b2d; background-color: #4f3b2d; }
QToolTip { background-color: #33261e; color: #f1e3cf; border: 1px solid #4f3b2d; padding: 3px 5px; }

QMenuBar { background-color: #2d201a; border-bottom: 1px solid #4f3b2d; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #372a22; }
QMenuBar::item:pressed { background-color: #8c5f30; color: #ffffff; }
QMenu { background-color: #2d201a; border: 1px solid #4f3b2d; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #8c5f30; color: #ffffff; }
QMenu::item:disabled { color: #70645a; }
QMenu::separator { height: 1px; background-color: #4f3b2d; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/figglebottom/check-dim.png); }
QMenu::right-arrow { image: url(images/figglebottom/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #2d201a; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #4f3b2d; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #4f3b2d; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #372a22; border-color: #4f3b2d; }
QToolButton:pressed { background-color: #2a1e17; }
QToolButton:checked { background-color: #8c5f30; border-color: #d39c5c; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/figglebottom/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #f1e3cf; titlebar-close-icon: url(images/figglebottom/close.png); titlebar-normal-icon: url(images/figglebottom/float.png); }
QDockWidget::title { background-color: #2d201a; padding: 4px 6px; border-bottom: 1px solid #4f3b2d; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #372a22; border-color: #4f3b2d; }
QTabWidget::pane { border: 1px solid #4f3b2d; top: -1px; background-color: #231813; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #2d201a; color: #ab9c8b; border: 1px solid #4f3b2d; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #231813; color: #f1e3cf; }
QTabBar::tab:top:selected { border-top: 2px solid #d39c5c; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #d39c5c; }
QTabBar::tab:hover:!selected { background-color: #372a22; color: #f1e3cf; }
QTabBar::close-button { image: url(images/figglebottom/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/figglebottom/close-hover.png); }
QTabBar QToolButton { background-color: #2d201a; border: 1px solid #4f3b2d; }
QTabBar QToolButton::left-arrow { image: url(images/figglebottom/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/figglebottom/arrow-right.png); }

QPushButton { background-color: #3a2a20; color: #f1e3cf; border: 1px solid #4f3b2d; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #49372b; border-color: #d39c5c; }
QPushButton:pressed { background-color: #2a1e17; }
QPushButton:checked { background-color: #8c5f30; color: #ffffff; border-color: #d39c5c; }
QPushButton:default { border-color: #d39c5c; }
QPushButton:disabled { color: #70645a; background-color: #231813; border-color: #4f3b2d; }
QPushButton::menu-indicator { image: url(images/figglebottom/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #19110d; color: #f1e3cf; border: 1px solid #4f3b2d; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #d39c5c; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #231813; color: #70645a; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #3a2a20; border-left: 1px solid #4f3b2d; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #49372b; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #2a1e17; }
QAbstractSpinBox::up-arrow { image: url(images/figglebottom/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/figglebottom/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #3a2a20; color: #f1e3cf; border: 1px solid #4f3b2d; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #19110d; }
QComboBox:hover { border-color: #d39c5c; }
QComboBox:on { border-color: #d39c5c; }
QComboBox:disabled { color: #70645a; background-color: #231813; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #4f3b2d; }
QComboBox::down-arrow { image: url(images/figglebottom/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #19110d; border: 1px solid #4f3b2d; selection-background-color: #8c5f30; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #19110d; border: 1px solid #614b3b; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #d39c5c; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #d39c5c; border-color: #d39c5c; image: url(images/figglebottom/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #d39c5c; border-color: #d39c5c; image: url(images/figglebottom/partial.png); }
QRadioButton::indicator:checked { background-color: #d39c5c; border-color: #d39c5c; image: url(images/figglebottom/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #231813; border-color: #4f3b2d; }
QCheckBox::indicator:checked:disabled { background-color: #4f3b2d; }

QGroupBox { border: 1px solid #4f3b2d; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #ab9c8b; }

QAbstractItemView { background-color: #19110d; alternate-background-color: #211712; color: #f1e3cf; border: 1px solid #4f3b2d; outline: 0; }
QAbstractItemView::item:hover { background-color: #372a22; }
QAbstractItemView::item:selected { background-color: #8c5f30; color: #ffffff; }
QAbstractItemView:disabled { color: #70645a; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/figglebottom/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/figglebottom/arrow-down.png); }
QHeaderView { background-color: #2d201a; }
QHeaderView::section { background-color: #2d201a; color: #ab9c8b; padding: 3px 6px; border: none; border-right: 1px solid #4f3b2d; border-bottom: 1px solid #4f3b2d; }
QHeaderView::section:hover { background-color: #372a22; color: #f1e3cf; }
QTableCornerButton::section { background-color: #2d201a; border: none; border-right: 1px solid #4f3b2d; border-bottom: 1px solid #4f3b2d; }

QScrollBar:vertical { background-color: #231813; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #231813; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #614b3b; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #79614e; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #231813; }

QSlider::groove:horizontal { height: 4px; background-color: #4f3b2d; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #4f3b2d; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #d39c5c; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #d39c5c; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #f1e3cf; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #f1e3cf; }
QSlider::handle:hover { background-color: #dfb27d; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #19110d; border: 1px solid #4f3b2d; border-radius: 2px; text-align: center; color: #f1e3cf; }
QProgressBar::chunk { background-color: #d39c5c; }
QSplitter::handle { background-color: #231813; }
QSplitter::handle:hover { background-color: #d39c5c; }
QStatusBar { background-color: #2d201a; border-top: 1px solid #4f3b2d; color: #ab9c8b; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
