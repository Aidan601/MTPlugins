/* base-style: plastique
   icon-recolor: #1f4f8f #f0f0f0
   Generated by tools/make_themes.py
   palette: bg=#f0f0f0 panel=#e4e4e4 base=#ffffff alt=#f6f6f6 border=#c2c2c2 text=#1e1f22 dim=#5c6068 disabled=#a4a7ad accent=#2f6db5 accent2=#3b8eea sel=#3b78c4 seltext=#ffffff hover=#d8d8d8 button=#e2e2e2 buttonhover=#d5d5d5 buttonpress=#c6c6c6 tip=#ffffff tiptext=#1e1f22 handle=#b9b9b9 handlehover=#9d9d9d mark=#ffffff icons=#1f4f8f */

QWidget { background-color: #f0f0f0; color: #1e1f22; selection-background-color: #3b78c4; selection-color: #ffffff; }
QWidget:disabled { color: #a4a7ad; }
QMainWindow, QDialog { background-color: #f0f0f0; }
QMainWindow::separator { background-color: #c2c2c2; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #2f6db5; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #c2c2c2; background-color: #c2c2c2; }
QToolTip { background-color: #ffffff; color: #1e1f22; border: 1px solid #c2c2c2; padding: 3px 5px; }

QMenuBar { background-color: #e4e4e4; border-bottom: 1px solid #c2c2c2; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #d8d8d8; }
QMenuBar::item:pressed { background-color: #3b78c4; color: #ffffff; }
QMenu { background-color: #e4e4e4; border: 1px solid #c2c2c2; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #3b78c4; color: #ffffff; }
QMenu::item:disabled { color: #a4a7ad; }
QMenu::separator { height: 1px; background-color: #c2c2c2; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/light/check-dim.png); }
QMenu::right-arrow { image: url(images/light/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #e4e4e4; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #c2c2c2; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #c2c2c2; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #d8d8d8; border-color: #c2c2c2; }
QToolButton:pressed { background-color: #c6c6c6; }
QToolButton:checked { background-color: #3b78c4; border-color: #2f6db5; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/light/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #1e1f22; titlebar-close-icon: url(images/light/close.png); titlebar-normal-icon: url(images/light/float.png); }
QDockWidget::title { background-color: #e4e4e4; padding: 4px 6px; border-bottom: 1px solid #c2c2c2; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #d8d8d8; border-color: #c2c2c2; }
QTabWidget::pane { border: 1px solid #c2c2c2; top: -1px; background-color: #f0f0f0; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #e4e4e4; color: #5c6068; border: 1px solid #c2c2c2; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #f0f0f0; color: #1e1f22; }
QTabBar::tab:top:selected { border-top: 2px solid #2f6db5; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #2f6db5; }
QTabBar::tab:hover:!selected { background-color: #d8d8d8; color: #1e1f22; }
QTabBar::close-button { image: url(images/light/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/light/close-hover.png); }
QTabBar QToolButton { background-color: #e4e4e4; border: 1px solid #c2c2c2; }
QTabBar QToolButton::left-arrow { image: url(images/light/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/light/arrow-right.png); }

QPushButton { background-color: #e2e2e2; color: #1e1f22; border: 1px solid #c2c2c2; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #d5d5d5; border-color: #2f6db5; }
QPushButton:pressed { background-color: #c6c6c6; }
QPushButton:checked { background-color: #3b78c4; color: #ffffff; border-color: #2f6db5; }
QPushButton:default { border-color: #2f6db5; }
QPushButton:disabled { color: #a4a7ad; background-color: #f0f0f0; border-color: #c2c2c2; }
QPushButton::menu-indicator { image: url(images/light/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #ffffff; color: #1e1f22; border: 1px solid #c2c2c2; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #2f6db5; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #f0f0f0; color: #a4a7ad; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #e2e2e2; border-left: 1px solid #c2c2c2; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #d5d5d5; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #c6c6c6; }
QAbstractSpinBox::up-arrow { image: url(images/light/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/light/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #e2e2e2; color: #1e1f22; border: 1px solid #c2c2c2; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #ffffff; }
QComboBox:hover { border-color: #2f6db5; }
QComboBox:on { border-color: #2f6db5; }
QComboBox:disabled { color: #a4a7ad; background-color: #f0f0f0; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #c2c2c2; }
QComboBox::down-arrow { image: url(images/light/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #ffffff; border: 1px solid #c2c2c2; selection-background-color: #3b78c4; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #ffffff; border: 1px solid #b9b9b9; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #2f6db5; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #2f6db5; border-color: #2f6db5; image: url(images/light/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #2f6db5; border-color: #2f6db5; image: url(images/light/partial.png); }
QRadioButton::indicator:checked { background-color: #2f6db5; border-color: #2f6db5; image: url(images/light/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #f0f0f0; border-color: #c2c2c2; }
QCheckBox::indicator:checked:disabled { background-color: #c2c2c2; }

QGroupBox { border: 1px solid #c2c2c2; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #5c6068; }

QAbstractItemView { background-color: #ffffff; alternate-background-color: #f6f6f6; color: #1e1f22; border: 1px solid #c2c2c2; outline: 0; }
QAbstractItemView::item:hover { background-color: #d8d8d8; }
QAbstractItemView::item:selected { background-color: #3b78c4; color: #ffffff; }
QAbstractItemView:disabled { color: #a4a7ad; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/light/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/light/arrow-down.png); }
QHeaderView { background-color: #e4e4e4; }
QHeaderView::section { background-color: #e4e4e4; color: #5c6068; padding: 3px 6px; border: none; border-right: 1px solid #c2c2c2; border-bottom: 1px solid #c2c2c2; }
QHeaderView::section:hover { background-color: #d8d8d8; color: #1e1f22; }
QTableCornerButton::section { background-color: #e4e4e4; border: none; border-right: 1px solid #c2c2c2; border-bottom: 1px solid #c2c2c2; }

QScrollBar:vertical { background-color: #f0f0f0; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #f0f0f0; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #b9b9b9; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #9d9d9d; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #f0f0f0; }

QSlider::groove:horizontal { height: 4px; background-color: #c2c2c2; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #c2c2c2; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #2f6db5; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #2f6db5; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #1e1f22; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #1e1f22; }
QSlider::handle:hover { background-color: #3b8eea; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #ffffff; border: 1px solid #c2c2c2; border-radius: 2px; text-align: center; color: #1e1f22; }
QProgressBar::chunk { background-color: #2f6db5; }
QSplitter::handle { background-color: #f0f0f0; }
QSplitter::handle:hover { background-color: #2f6db5; }
QStatusBar { background-color: #e4e4e4; border-top: 1px solid #c2c2c2; color: #5c6068; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
