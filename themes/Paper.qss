/* base-style: plastique
   icon-recolor: #7a3a17 #ede0c6
   Generated by tools/make_themes.py
   palette: bg=#ede0c6 panel=#e2d1b1 base=#f9f1e0 alt=#efe3cb border=#c4ac83 text=#33281a dim=#746856 disabled=#a69a85 accent=#ad4f22 accent2=#bc6f4a sel=#bc6331 seltext=#ffffff hover=#daceb5 button=#ddcaa6 buttonhover=#cfbd9b buttonpress=#c9b795 tip=#f9f1e0 tiptext=#33281a handle=#b39c76 handlehover=#a08b69 mark=#ffffff icons=#7a3a17 */

QWidget { background-color: #ede0c6; color: #33281a; selection-background-color: #bc6331; selection-color: #ffffff; }
QWidget:disabled { color: #a69a85; }
QMainWindow, QDialog { background-color: #ede0c6; }
QMainWindow::separator { background-color: #c4ac83; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #ad4f22; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #c4ac83; background-color: #c4ac83; }
QToolTip { background-color: #f9f1e0; color: #33281a; border: 1px solid #c4ac83; padding: 3px 5px; }

QMenuBar { background-color: #e2d1b1; border-bottom: 1px solid #c4ac83; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #daceb5; }
QMenuBar::item:pressed { background-color: #bc6331; color: #ffffff; }
QMenu { background-color: #e2d1b1; border: 1px solid #c4ac83; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #bc6331; color: #ffffff; }
QMenu::item:disabled { color: #a69a85; }
QMenu::separator { height: 1px; background-color: #c4ac83; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/paper/check-dim.png); }
QMenu::right-arrow { image: url(images/paper/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #e2d1b1; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #c4ac83; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #c4ac83; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #daceb5; border-color: #c4ac83; }
QToolButton:pressed { background-color: #c9b795; }
QToolButton:checked { background-color: #bc6331; border-color: #ad4f22; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/paper/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #33281a; titlebar-close-icon: url(images/paper/close.png); titlebar-normal-icon: url(images/paper/float.png); }
QDockWidget::title { background-color: #e2d1b1; padding: 4px 6px; border-bottom: 1px solid #c4ac83; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #daceb5; border-color: #c4ac83; }
QTabWidget::pane { border: 1px solid #c4ac83; top: -1px; background-color: #ede0c6; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #e2d1b1; color: #746856; border: 1px solid #c4ac83; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #ede0c6; color: #33281a; }
QTabBar::tab:top:selected { border-top: 2px solid #ad4f22; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #ad4f22; }
QTabBar::tab:hover:!selected { background-color: #daceb5; color: #33281a; }
QTabBar::close-button { image: url(images/paper/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/paper/close-hover.png); }
QTabBar QToolButton { background-color: #e2d1b1; border: 1px solid #c4ac83; }
QTabBar QToolButton::left-arrow { image: url(images/paper/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/paper/arrow-right.png); }

QPushButton { background-color: #ddcaa6; color: #33281a; border: 1px solid #c4ac83; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #cfbd9b; border-color: #ad4f22; }
QPushButton:pressed { background-color: #c9b795; }
QPushButton:checked { background-color: #bc6331; color: #ffffff; border-color: #ad4f22; }
QPushButton:default { border-color: #ad4f22; }
QPushButton:disabled { color: #a69a85; background-color: #ede0c6; border-color: #c4ac83; }
QPushButton::menu-indicator { image: url(images/paper/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #f9f1e0; color: #33281a; border: 1px solid #c4ac83; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #ad4f22; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #ede0c6; color: #a69a85; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #ddcaa6; border-left: 1px solid #c4ac83; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #cfbd9b; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #c9b795; }
QAbstractSpinBox::up-arrow { image: url(images/paper/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/paper/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #ddcaa6; color: #33281a; border: 1px solid #c4ac83; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #f9f1e0; }
QComboBox:hover { border-color: #ad4f22; }
QComboBox:on { border-color: #ad4f22; }
QComboBox:disabled { color: #a69a85; background-color: #ede0c6; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #c4ac83; }
QComboBox::down-arrow { image: url(images/paper/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #f9f1e0; border: 1px solid #c4ac83; selection-background-color: #bc6331; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #f9f1e0; border: 1px solid #b39c76; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #ad4f22; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #ad4f22; border-color: #ad4f22; image: url(images/paper/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #ad4f22; border-color: #ad4f22; image: url(images/paper/partial.png); }
QRadioButton::indicator:checked { background-color: #ad4f22; border-color: #ad4f22; image: url(images/paper/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #ede0c6; border-color: #c4ac83; }
QCheckBox::indicator:checked:disabled { background-color: #c4ac83; }

QGroupBox { border: 1px solid #c4ac83; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #746856; }

QAbstractItemView { background-color: #f9f1e0; alternate-background-color: #efe3cb; color: #33281a; border: 1px solid #c4ac83; outline: 0; }
QAbstractItemView::item:hover { background-color: #daceb5; }
QAbstractItemView::item:selected { background-color: #bc6331; color: #ffffff; }
QAbstractItemView:disabled { color: #a69a85; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/paper/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/paper/arrow-down.png); }
QHeaderView { background-color: #e2d1b1; }
QHeaderView::section { background-color: #e2d1b1; color: #746856; padding: 3px 6px; border: none; border-right: 1px solid #c4ac83; border-bottom: 1px solid #c4ac83; }
QHeaderView::section:hover { background-color: #daceb5; color: #33281a; }
QTableCornerButton::section { background-color: #e2d1b1; border: none; border-right: 1px solid #c4ac83; border-bottom: 1px solid #c4ac83; }

QScrollBar:vertical { background-color: #ede0c6; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #ede0c6; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #b39c76; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #a08b69; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #ede0c6; }

QSlider::groove:horizontal { height: 4px; background-color: #c4ac83; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #c4ac83; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #ad4f22; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #ad4f22; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #33281a; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #33281a; }
QSlider::handle:hover { background-color: #bc6f4a; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #f9f1e0; border: 1px solid #c4ac83; border-radius: 2px; text-align: center; color: #33281a; }
QProgressBar::chunk { background-color: #ad4f22; }
QSplitter::handle { background-color: #ede0c6; }
QSplitter::handle:hover { background-color: #ad4f22; }
QStatusBar { background-color: #e2d1b1; border-top: 1px solid #c4ac83; color: #746856; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
