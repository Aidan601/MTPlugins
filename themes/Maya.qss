/* base-style: plastique
   icon-recolor: #c8c8c8 #444444
   Generated by tools/make_themes.py
   palette: bg=#444444 panel=#3a3a3a base=#2b2b2b alt=#323232 border=#2a2a2a text=#c8c8c8 dim=#9a9a9a disabled=#6e6e6e accent=#5285a6 accent2=#6a9cbd sel=#5285a6 seltext=#ffffff hover=#525252 button=#5d5d5d buttonhover=#707070 buttonpress=#2b2b2b tip=#2b2b2b tiptext=#c8c8c8 handle=#5d5d5d handlehover=#707070 mark=#ffffff icons=#c8c8c8 */

QWidget { background-color: #444444; color: #c8c8c8; selection-background-color: #5285a6; selection-color: #ffffff; }
QWidget:disabled { color: #6e6e6e; }
QMainWindow, QDialog { background-color: #444444; }
QMainWindow::separator { background-color: #2a2a2a; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #5285a6; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #2a2a2a; background-color: #2a2a2a; }
QToolTip { background-color: #2b2b2b; color: #c8c8c8; border: 1px solid #2a2a2a; padding: 3px 5px; }

QMenuBar { background-color: #3a3a3a; border-bottom: 1px solid #2a2a2a; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #525252; }
QMenuBar::item:pressed { background-color: #5285a6; color: #ffffff; }
QMenu { background-color: #3a3a3a; border: 1px solid #2a2a2a; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #5285a6; color: #ffffff; }
QMenu::item:disabled { color: #6e6e6e; }
QMenu::separator { height: 1px; background-color: #2a2a2a; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/maya/check-dim.png); }
QMenu::right-arrow { image: url(images/maya/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #3a3a3a; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #2a2a2a; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #2a2a2a; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #525252; border-color: #2a2a2a; }
QToolButton:pressed { background-color: #2b2b2b; }
QToolButton:checked { background-color: #5285a6; border-color: #5285a6; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/maya/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #c8c8c8; titlebar-close-icon: url(images/maya/close.png); titlebar-normal-icon: url(images/maya/float.png); }
QDockWidget::title { background-color: #3a3a3a; padding: 4px 6px; border-bottom: 1px solid #2a2a2a; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #525252; border-color: #2a2a2a; }
QTabWidget::pane { border: 1px solid #2a2a2a; top: -1px; background-color: #444444; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #3a3a3a; color: #9a9a9a; border: 1px solid #2a2a2a; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #444444; color: #c8c8c8; }
QTabBar::tab:top:selected { border-top: 2px solid #5285a6; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #5285a6; }
QTabBar::tab:hover:!selected { background-color: #525252; color: #c8c8c8; }
QTabBar::close-button { image: url(images/maya/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/maya/close-hover.png); }
QTabBar QToolButton { background-color: #3a3a3a; border: 1px solid #2a2a2a; }
QTabBar QToolButton::left-arrow { image: url(images/maya/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/maya/arrow-right.png); }

QPushButton { background-color: #5d5d5d; color: #c8c8c8; border: 1px solid #2a2a2a; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #707070; border-color: #5285a6; }
QPushButton:pressed { background-color: #2b2b2b; }
QPushButton:checked { background-color: #5285a6; color: #ffffff; border-color: #5285a6; }
QPushButton:default { border-color: #5285a6; }
QPushButton:disabled { color: #6e6e6e; background-color: #444444; border-color: #2a2a2a; }
QPushButton::menu-indicator { image: url(images/maya/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #2b2b2b; color: #c8c8c8; border: 1px solid #2a2a2a; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #5285a6; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #444444; color: #6e6e6e; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #5d5d5d; border-left: 1px solid #2a2a2a; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #707070; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #2b2b2b; }
QAbstractSpinBox::up-arrow { image: url(images/maya/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/maya/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #5d5d5d; color: #c8c8c8; border: 1px solid #2a2a2a; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #2b2b2b; }
QComboBox:hover { border-color: #5285a6; }
QComboBox:on { border-color: #5285a6; }
QComboBox:disabled { color: #6e6e6e; background-color: #444444; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #2a2a2a; }
QComboBox::down-arrow { image: url(images/maya/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #2b2b2b; border: 1px solid #2a2a2a; selection-background-color: #5285a6; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #2b2b2b; border: 1px solid #5d5d5d; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #5285a6; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #5285a6; border-color: #5285a6; image: url(images/maya/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #5285a6; border-color: #5285a6; image: url(images/maya/partial.png); }
QRadioButton::indicator:checked { background-color: #5285a6; border-color: #5285a6; image: url(images/maya/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #444444; border-color: #2a2a2a; }
QCheckBox::indicator:checked:disabled { background-color: #2a2a2a; }

QGroupBox { border: 1px solid #2a2a2a; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #9a9a9a; }

QAbstractItemView { background-color: #2b2b2b; alternate-background-color: #323232; color: #c8c8c8; border: 1px solid #2a2a2a; outline: 0; }
QAbstractItemView::item:hover { background-color: #525252; }
QAbstractItemView::item:selected { background-color: #5285a6; color: #ffffff; }
QAbstractItemView:disabled { color: #6e6e6e; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/maya/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/maya/arrow-down.png); }
QHeaderView { background-color: #3a3a3a; }
QHeaderView::section { background-color: #3a3a3a; color: #9a9a9a; padding: 3px 6px; border: none; border-right: 1px solid #2a2a2a; border-bottom: 1px solid #2a2a2a; }
QHeaderView::section:hover { background-color: #525252; color: #c8c8c8; }
QTableCornerButton::section { background-color: #3a3a3a; border: none; border-right: 1px solid #2a2a2a; border-bottom: 1px solid #2a2a2a; }

QScrollBar:vertical { background-color: #444444; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #444444; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #5d5d5d; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #707070; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #444444; }

QSlider::groove:horizontal { height: 4px; background-color: #2a2a2a; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #2a2a2a; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #5285a6; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #5285a6; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #c8c8c8; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #c8c8c8; }
QSlider::handle:hover { background-color: #6a9cbd; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #2b2b2b; border: 1px solid #2a2a2a; border-radius: 2px; text-align: center; color: #c8c8c8; }
QProgressBar::chunk { background-color: #5285a6; }
QSplitter::handle { background-color: #444444; }
QSplitter::handle:hover { background-color: #5285a6; }
QStatusBar { background-color: #3a3a3a; border-top: 1px solid #2a2a2a; color: #9a9a9a; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }

QPushButton { background-color: #5d5d5d; border: none; border-radius: 2px; padding: 4px 12px; }
QPushButton:hover { background-color: #707070; }
QPushButton:pressed, QPushButton:checked { background-color: #5285a6; color: #ffffff; }
QPushButton:default { background-color: #686868; }
QPushButton:disabled { background-color: #4d4d4d; }
QToolButton { border-radius: 2px; }
QToolButton:hover { background-color: #5d5d5d; border-color: #5d5d5d; }
QToolButton:checked { background-color: #5285a6; border-color: #5285a6; }
QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #2b2b2b; border: 1px solid #2b2b2b; border-radius: 2px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #5285a6; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { background-color: #5d5d5d; border-left: none; }
QComboBox { background-color: #5d5d5d; border: none; border-radius: 2px; }
QComboBox:hover { background-color: #707070; }
QComboBox::drop-down { border-left: none; }
QMenuBar { background-color: #444444; border-bottom: none; }
QMenu { background-color: #444444; border: 1px solid #2b2b2b; }
QMenu::item:selected { background-color: #5285a6; }
QTabBar::tab { background-color: #3a3a3a; border-color: #2b2b2b; }
QTabBar::tab:top, QTabBar::tab:bottom { border-radius: 0px; }
QTabBar::tab:selected { background-color: #5d5d5d; color: #ffffff; }
QTabBar::tab:top:selected, QTabBar::tab:bottom:selected { border-top: 1px solid #2b2b2b; border-bottom: 1px solid #2b2b2b; }
QCheckBox::indicator, QAbstractItemView::indicator { background-color: #2b2b2b; border: 1px solid #2b2b2b; border-radius: 2px; }
QRadioButton::indicator { background-color: #2b2b2b; border: 1px solid #2b2b2b; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked, QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate, QRadioButton::indicator:checked { background-color: #2b2b2b; border-color: #2b2b2b; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #707070; }
QGroupBox { border: 1px solid #3a3a3a; border-radius: 2px; margin-top: 22px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; left: 0px; padding: 3px 10px; background-color: #5d5d5d; color: #e0e0e0; border-radius: 2px; }
QHeaderView::section { background-color: #5d5d5d; color: #c8c8c8; border-color: #444444; }
QSlider::groove:horizontal { height: 4px; background-color: #2b2b2b; border-radius: 0px; }
QSlider::groove:vertical { width: 4px; background-color: #2b2b2b; border-radius: 0px; }
QSlider::sub-page:horizontal, QSlider::add-page:vertical { background-color: #2b2b2b; }
QSlider::handle:horizontal { width: 8px; margin: -6px 0px; border-radius: 1px; background-color: #bdbdbd; }
QSlider::handle:vertical { height: 8px; margin: 0px -6px; border-radius: 1px; background-color: #bdbdbd; }
QProgressBar { background-color: #2b2b2b; border: none; border-radius: 2px; }
QProgressBar::chunk { background-color: #5285a6; }
QScrollBar::handle { border-radius: 2px; }
