/* base-style: plastique
   icon-recolor: #d8ded3 #4c5844
   Generated by tools/make_themes.py
   palette: bg=#4c5844 panel=#4c5844 base=#3e4637 alt=#434b3b border=#292c21 text=#d8ded3 dim=#a0aa95 disabled=#7e8873 accent=#c4b550 accent2=#d6c867 sel=#958831 seltext=#ffffff hover=#56634d button=#4c5844 buttonhover=#4c5844 buttonpress=#434d3c tip=#3e4637 tiptext=#d8ded3 handle=#4c5844 handlehover=#56634d mark=#d8ded3 icons=#d8ded3 */

QWidget { background-color: #4c5844; color: #d8ded3; selection-background-color: #958831; selection-color: #ffffff; }
QWidget:disabled { color: #7e8873; }
QMainWindow, QDialog { background-color: #4c5844; }
QMainWindow::separator { background-color: #292c21; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #c4b550; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #292c21; background-color: #292c21; }
QToolTip { background-color: #3e4637; color: #d8ded3; border: 1px solid #292c21; padding: 3px 5px; }

QMenuBar { background-color: #4c5844; border-bottom: 1px solid #292c21; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #56634d; }
QMenuBar::item:pressed { background-color: #958831; color: #ffffff; }
QMenu { background-color: #4c5844; border: 1px solid #292c21; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #958831; color: #ffffff; }
QMenu::item:disabled { color: #7e8873; }
QMenu::separator { height: 1px; background-color: #292c21; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/steamclassic/check-dim.png); }
QMenu::right-arrow { image: url(images/steamclassic/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #4c5844; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #292c21; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #292c21; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #56634d; border-color: #292c21; }
QToolButton:pressed { background-color: #434d3c; }
QToolButton:checked { background-color: #958831; border-color: #c4b550; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/steamclassic/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #d8ded3; titlebar-close-icon: url(images/steamclassic/close.png); titlebar-normal-icon: url(images/steamclassic/float.png); }
QDockWidget::title { background-color: #4c5844; padding: 4px 6px; border-bottom: 1px solid #292c21; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #56634d; border-color: #292c21; }
QTabWidget::pane { border: 1px solid #292c21; top: -1px; background-color: #4c5844; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #4c5844; color: #a0aa95; border: 1px solid #292c21; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #4c5844; color: #d8ded3; }
QTabBar::tab:top:selected { border-top: 2px solid #c4b550; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #c4b550; }
QTabBar::tab:hover:!selected { background-color: #56634d; color: #d8ded3; }
QTabBar::close-button { image: url(images/steamclassic/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/steamclassic/close-hover.png); }
QTabBar QToolButton { background-color: #4c5844; border: 1px solid #292c21; }
QTabBar QToolButton::left-arrow { image: url(images/steamclassic/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/steamclassic/arrow-right.png); }

QPushButton { background-color: #4c5844; color: #d8ded3; border: 1px solid #292c21; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #4c5844; border-color: #c4b550; }
QPushButton:pressed { background-color: #434d3c; }
QPushButton:checked { background-color: #958831; color: #ffffff; border-color: #c4b550; }
QPushButton:default { border-color: #c4b550; }
QPushButton:disabled { color: #7e8873; background-color: #4c5844; border-color: #292c21; }
QPushButton::menu-indicator { image: url(images/steamclassic/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #3e4637; color: #d8ded3; border: 1px solid #292c21; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #c4b550; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #4c5844; color: #7e8873; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #4c5844; border-left: 1px solid #292c21; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #4c5844; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #434d3c; }
QAbstractSpinBox::up-arrow { image: url(images/steamclassic/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/steamclassic/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #4c5844; color: #d8ded3; border: 1px solid #292c21; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #3e4637; }
QComboBox:hover { border-color: #c4b550; }
QComboBox:on { border-color: #c4b550; }
QComboBox:disabled { color: #7e8873; background-color: #4c5844; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #292c21; }
QComboBox::down-arrow { image: url(images/steamclassic/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #3e4637; border: 1px solid #292c21; selection-background-color: #958831; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #3e4637; border: 1px solid #4c5844; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #c4b550; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #c4b550; border-color: #c4b550; image: url(images/steamclassic/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #c4b550; border-color: #c4b550; image: url(images/steamclassic/partial.png); }
QRadioButton::indicator:checked { background-color: #c4b550; border-color: #c4b550; image: url(images/steamclassic/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #4c5844; border-color: #292c21; }
QCheckBox::indicator:checked:disabled { background-color: #292c21; }

QGroupBox { border: 1px solid #292c21; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #a0aa95; }

QAbstractItemView { background-color: #3e4637; alternate-background-color: #434b3b; color: #d8ded3; border: 1px solid #292c21; outline: 0; }
QAbstractItemView::item:hover { background-color: #56634d; }
QAbstractItemView::item:selected { background-color: #958831; color: #ffffff; }
QAbstractItemView:disabled { color: #7e8873; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/steamclassic/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/steamclassic/arrow-down.png); }
QHeaderView { background-color: #4c5844; }
QHeaderView::section { background-color: #4c5844; color: #a0aa95; padding: 3px 6px; border: none; border-right: 1px solid #292c21; border-bottom: 1px solid #292c21; }
QHeaderView::section:hover { background-color: #56634d; color: #d8ded3; }
QTableCornerButton::section { background-color: #4c5844; border: none; border-right: 1px solid #292c21; border-bottom: 1px solid #292c21; }

QScrollBar:vertical { background-color: #4c5844; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #4c5844; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #4c5844; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #56634d; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #4c5844; }

QSlider::groove:horizontal { height: 4px; background-color: #292c21; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #292c21; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #c4b550; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #c4b550; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #d8ded3; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #d8ded3; }
QSlider::handle:hover { background-color: #d6c867; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #3e4637; border: 1px solid #292c21; border-radius: 2px; text-align: center; color: #d8ded3; }
QProgressBar::chunk { background-color: #c4b550; }
QSplitter::handle { background-color: #4c5844; }
QSplitter::handle:hover { background-color: #c4b550; }
QStatusBar { background-color: #4c5844; border-top: 1px solid #292c21; color: #a0aa95; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }

QToolTip { border: 1px solid #8c9284; }
QMenuBar { border-bottom: 1px solid #292c21; }
QMenuBar::item:selected { background-color: #958831; color: #ffffff; }
QMenu { border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; }
QToolButton { border-radius: 0px; }
QToolButton:hover { background-color: transparent; border-color: #8c9284 #292c21 #292c21 #8c9284; }
QToolButton:pressed, QToolButton:checked { background-color: #434d3c; border-color: #292c21 #8c9284 #8c9284 #292c21; }
QTabWidget::pane { border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; }
QTabBar::tab { background-color: #434b3b; color: #a0aa95; border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; }
QTabBar::tab:top, QTabBar::tab:bottom { border-radius: 0px; }
QTabBar::tab:top { border-bottom: none; }
QTabBar::tab:bottom { border-top: none; }
QTabBar::tab:selected { background-color: #4c5844; color: #c4b550; }
QTabBar::tab:top:selected { border-top: 1px solid #8c9284; }
QTabBar::tab:bottom:selected { border-bottom: 1px solid #292c21; }
QTabBar::tab:hover:!selected { background-color: #434b3b; color: #d8ded3; }
QPushButton { border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; border-radius: 0px; }
QPushButton:hover { color: #c4b550; border-color: #8c9284 #292c21 #292c21 #8c9284; }
QPushButton:pressed, QPushButton:checked { background-color: #434d3c; color: #c4b550; border-color: #292c21 #8c9284 #8c9284 #292c21; }
QPushButton:default { border-color: #8c9284 #000000 #000000 #8c9284; }
QPushButton:disabled { background-color: #4c5844; border-color: #8c9284 #292c21 #292c21 #8c9284; }
QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox, QComboBox { border: 1px solid; border-color: #292c21 #8c9284 #8c9284 #292c21; border-radius: 0px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus, QComboBox:hover, QComboBox:on { border-color: #292c21 #8c9284 #8c9284 #292c21; }
QComboBox { background-color: #3e4637; }
QComboBox:disabled { background-color: #4c5844; }
QComboBox::drop-down { background-color: #4c5844; border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; }
QComboBox::drop-down:on { border-color: #292c21 #8c9284 #8c9284 #292c21; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { border-color: #292c21 #8c9284 #8c9284 #292c21; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { border-radius: 0px; }
QCheckBox::indicator, QAbstractItemView::indicator { border: 1px solid; border-color: #292c21 #8c9284 #8c9284 #292c21; border-radius: 0px; }
QRadioButton::indicator { border: 1px solid; border-color: #292c21 #8c9284 #8c9284 #292c21; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #292c21 #c4b550 #c4b550 #292c21; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked, QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate, QRadioButton::indicator:checked { background-color: #3e4637; border-color: #292c21 #8c9284 #8c9284 #292c21; }
QCheckBox::indicator:checked:disabled { background-color: #4c5844; }
QGroupBox { border: 1px solid; border-color: #292c21 #8c9284 #8c9284 #292c21; border-radius: 0px; }
QGroupBox::title { color: #d8ded3; }
QAbstractItemView { border: 1px solid; border-color: #292c21 #8c9284 #8c9284 #292c21; }
QHeaderView::section { background-color: #4c5844; color: #d8ded3; border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; }
QHeaderView::section:hover { background-color: #4c5844; color: #c4b550; }
QScrollBar:vertical { background-color: #434b3b; width: 16px; margin: 16px 0px 16px 0px; }
QScrollBar:horizontal { background-color: #434b3b; height: 16px; margin: 0px 16px 0px 16px; }
QScrollBar::handle { background-color: #4c5844; border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; border-radius: 0px; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { margin: 0px; }
QScrollBar::handle:hover { background-color: #56634d; }
QScrollBar::add-line, QScrollBar::sub-line { background-color: #4c5844; border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; subcontrol-origin: margin; }
QScrollBar::add-line:pressed, QScrollBar::sub-line:pressed { border-color: #292c21 #8c9284 #8c9284 #292c21; }
QScrollBar::add-line:vertical { height: 14px; width: 14px; subcontrol-position: bottom; }
QScrollBar::sub-line:vertical { height: 14px; width: 14px; subcontrol-position: top; }
QScrollBar::add-line:horizontal { width: 14px; height: 14px; subcontrol-position: right; }
QScrollBar::sub-line:horizontal { width: 14px; height: 14px; subcontrol-position: left; }
QScrollBar::up-arrow { image: url(images/steamclassic/arrow-up.png); width: 8px; height: 8px; }
QScrollBar::down-arrow { image: url(images/steamclassic/arrow-down.png); width: 8px; height: 8px; }
QScrollBar::left-arrow { image: url(images/steamclassic/arrow-left.png); width: 8px; height: 8px; }
QScrollBar::right-arrow { image: url(images/steamclassic/arrow-right.png); width: 8px; height: 8px; }
QSlider::groove:horizontal, QSlider::groove:vertical { background-color: #3e4637; border: 1px solid; border-color: #292c21 #8c9284 #8c9284 #292c21; border-radius: 0px; }
QSlider::sub-page:horizontal, QSlider::add-page:vertical { background-color: #958831; border-radius: 0px; }
QSlider::handle:horizontal { width: 8px; margin: -6px 0px; }
QSlider::handle:vertical { height: 8px; margin: 0px -6px; }
QSlider::handle:horizontal, QSlider::handle:vertical { background-color: #4c5844; border: 1px solid; border-color: #8c9284 #292c21 #292c21 #8c9284; border-radius: 0px; }
QSlider::handle:hover { background-color: #56634d; }
QProgressBar { background-color: #3e4637; border: 1px solid; border-color: #292c21 #8c9284 #8c9284 #292c21; border-radius: 0px; }
QProgressBar::chunk { background-color: #c4b550; width: 6px; margin: 1px; }
QSplitter::handle:hover, QMainWindow::separator:hover { background-color: #8c9284; }
QStatusBar { border-top: 1px solid #8c9284; }
