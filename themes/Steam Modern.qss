/* base-style: plastique
   icon-recolor: #dcdedf #23262e
   Generated by tools/make_themes.py
   palette: bg=#23262e panel=#171a21 base=#1a1d23 alt=#1e2128 border=#32363f text=#dcdedf dim=#8b929a disabled=#5c6168 accent=#1a9fff accent2=#4cb0ff sel=#3d4450 seltext=#ffffff hover=#2c3039 button=#3d4450 buttonhover=#dcdedf buttonpress=#1a9fff tip=#3d4450 tiptext=#ffffff handle=#3d4450 handlehover=#5a6270 mark=#ffffff icons=#dcdedf */

QWidget { background-color: #23262e; color: #dcdedf; selection-background-color: #3d4450; selection-color: #ffffff; }
QWidget:disabled { color: #5c6168; }
QMainWindow, QDialog { background-color: #23262e; }
QMainWindow::separator { background-color: #32363f; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #1a9fff; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #32363f; background-color: #32363f; }
QToolTip { background-color: #3d4450; color: #ffffff; border: 1px solid #32363f; padding: 3px 5px; }

QMenuBar { background-color: #171a21; border-bottom: 1px solid #32363f; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #2c3039; }
QMenuBar::item:pressed { background-color: #3d4450; color: #ffffff; }
QMenu { background-color: #171a21; border: 1px solid #32363f; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #3d4450; color: #ffffff; }
QMenu::item:disabled { color: #5c6168; }
QMenu::separator { height: 1px; background-color: #32363f; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/steammodern/check-dim.png); }
QMenu::right-arrow { image: url(images/steammodern/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #171a21; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #32363f; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #32363f; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #2c3039; border-color: #32363f; }
QToolButton:pressed { background-color: #1a9fff; }
QToolButton:checked { background-color: #3d4450; border-color: #1a9fff; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/steammodern/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #dcdedf; titlebar-close-icon: url(images/steammodern/close.png); titlebar-normal-icon: url(images/steammodern/float.png); }
QDockWidget::title { background-color: #171a21; padding: 4px 6px; border-bottom: 1px solid #32363f; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #2c3039; border-color: #32363f; }
QTabWidget::pane { border: 1px solid #32363f; top: -1px; background-color: #23262e; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #171a21; color: #8b929a; border: 1px solid #32363f; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #23262e; color: #dcdedf; }
QTabBar::tab:top:selected { border-top: 2px solid #1a9fff; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #1a9fff; }
QTabBar::tab:hover:!selected { background-color: #2c3039; color: #dcdedf; }
QTabBar::close-button { image: url(images/steammodern/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/steammodern/close-hover.png); }
QTabBar QToolButton { background-color: #171a21; border: 1px solid #32363f; }
QTabBar QToolButton::left-arrow { image: url(images/steammodern/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/steammodern/arrow-right.png); }

QPushButton { background-color: #3d4450; color: #dcdedf; border: 1px solid #32363f; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #dcdedf; border-color: #1a9fff; }
QPushButton:pressed { background-color: #1a9fff; }
QPushButton:checked { background-color: #3d4450; color: #ffffff; border-color: #1a9fff; }
QPushButton:default { border-color: #1a9fff; }
QPushButton:disabled { color: #5c6168; background-color: #23262e; border-color: #32363f; }
QPushButton::menu-indicator { image: url(images/steammodern/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #1a1d23; color: #dcdedf; border: 1px solid #32363f; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #1a9fff; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #23262e; color: #5c6168; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #3d4450; border-left: 1px solid #32363f; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #dcdedf; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #1a9fff; }
QAbstractSpinBox::up-arrow { image: url(images/steammodern/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/steammodern/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #3d4450; color: #dcdedf; border: 1px solid #32363f; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #1a1d23; }
QComboBox:hover { border-color: #1a9fff; }
QComboBox:on { border-color: #1a9fff; }
QComboBox:disabled { color: #5c6168; background-color: #23262e; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #32363f; }
QComboBox::down-arrow { image: url(images/steammodern/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #1a1d23; border: 1px solid #32363f; selection-background-color: #3d4450; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #1a1d23; border: 1px solid #3d4450; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #1a9fff; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #1a9fff; border-color: #1a9fff; image: url(images/steammodern/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #1a9fff; border-color: #1a9fff; image: url(images/steammodern/partial.png); }
QRadioButton::indicator:checked { background-color: #1a9fff; border-color: #1a9fff; image: url(images/steammodern/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #23262e; border-color: #32363f; }
QCheckBox::indicator:checked:disabled { background-color: #32363f; }

QGroupBox { border: 1px solid #32363f; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #8b929a; }

QAbstractItemView { background-color: #1a1d23; alternate-background-color: #1e2128; color: #dcdedf; border: 1px solid #32363f; outline: 0; }
QAbstractItemView::item:hover { background-color: #2c3039; }
QAbstractItemView::item:selected { background-color: #3d4450; color: #ffffff; }
QAbstractItemView:disabled { color: #5c6168; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/steammodern/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/steammodern/arrow-down.png); }
QHeaderView { background-color: #171a21; }
QHeaderView::section { background-color: #171a21; color: #8b929a; padding: 3px 6px; border: none; border-right: 1px solid #32363f; border-bottom: 1px solid #32363f; }
QHeaderView::section:hover { background-color: #2c3039; color: #dcdedf; }
QTableCornerButton::section { background-color: #171a21; border: none; border-right: 1px solid #32363f; border-bottom: 1px solid #32363f; }

QScrollBar:vertical { background-color: #23262e; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #23262e; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #3d4450; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #5a6270; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #23262e; }

QSlider::groove:horizontal { height: 4px; background-color: #32363f; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #32363f; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #1a9fff; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #1a9fff; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #dcdedf; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #dcdedf; }
QSlider::handle:hover { background-color: #4cb0ff; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #1a1d23; border: 1px solid #32363f; border-radius: 2px; text-align: center; color: #dcdedf; }
QProgressBar::chunk { background-color: #1a9fff; }
QSplitter::handle { background-color: #23262e; }
QSplitter::handle:hover { background-color: #1a9fff; }
QStatusBar { background-color: #171a21; border-top: 1px solid #32363f; color: #8b929a; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }

QMenuBar { background-color: #171a21; border-bottom: none; }
QMenuBar::item { color: #b8bcbf; padding: 5px 10px; }
QMenuBar::item:selected, QMenuBar::item:pressed { background-color: transparent; color: #ffffff; }
QMenu { background-color: #3d4450; border: none; padding: 4px 0px; }
QMenu::item { color: #dcdedf; }
QMenu::item:selected { background-color: #dcdedf; color: #23262e; }
QMenu::separator { background-color: #4c5361; }
QToolButton { border-radius: 2px; }
QToolButton:hover { background-color: #3d4450; border-color: #3d4450; }
QToolButton:checked { background-color: #1a9fff; border-color: #1a9fff; }
QPushButton { background-color: #3d4450; color: #dcdedf; border: none; border-radius: 2px; padding: 5px 16px; }
QPushButton:hover { background-color: #dcdedf; color: #23262e; }
QPushButton:pressed, QPushButton:checked { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #47bfff, stop:1 #1a44c2); color: #ffffff; }
QPushButton:default { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #75b022, stop:1 #588a1b); color: #ffffff; }
QPushButton:default:hover { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #8ed629, stop:1 #6aa621); }
QPushButton:disabled { background-color: #2c3039; color: #5c6168; }
QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #32353c; border: 1px solid #32353c; border-radius: 3px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #1a9fff; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { background-color: transparent; border-left: none; }
QComboBox { background-color: #3d4450; border: none; border-radius: 2px; }
QComboBox:hover, QComboBox:on { background-color: #464d58; }
QComboBox::drop-down { border-left: none; }
QComboBox QAbstractItemView { background-color: #3d4450; border: none; selection-background-color: #dcdedf; selection-color: #23262e; }
QTabBar::tab { background-color: transparent; border: none; color: #8b929a; padding: 6px 12px; }
QTabBar::tab:selected { color: #ffffff; }
QTabBar::tab:top:selected { border-top: none; border-bottom: 2px solid #1a9fff; }
QTabBar::tab:bottom:selected { border-bottom: none; border-top: 2px solid #1a9fff; }
QTabBar::tab:hover:!selected { background-color: transparent; color: #dcdedf; }
QTabWidget::pane { border: none; border-top: 1px solid #32363f; }
QAbstractItemView::item:hover { background-color: #2c3039; }
QAbstractItemView::item:selected { background-color: #3d4450; color: #ffffff; }
QCheckBox::indicator, QAbstractItemView::indicator { background-color: #3d4450; border: 1px solid #3d4450; border-radius: 2px; }
QRadioButton::indicator { background-color: #3d4450; border: 1px solid #3d4450; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #8b929a; }
QGroupBox { border: none; border-top: 1px solid #3d4450; border-radius: 0px; margin-top: 18px; padding-top: 6px; }
QGroupBox::title { color: #8b929a; left: 0px; padding: 0px 4px 0px 0px; }
QHeaderView::section { background-color: #23262e; color: #8b929a; border-color: #171a21; }
QDockWidget::title { background-color: #171a21; border-bottom: none; }
QStatusBar { background-color: #171a21; border-top: none; }
QSlider::groove:horizontal { height: 4px; background-color: #3d4450; }
QSlider::groove:vertical { width: 4px; background-color: #3d4450; }
QSlider::handle:horizontal, QSlider::handle:vertical { background-color: #dcdedf; }
QProgressBar { background-color: #3d4450; border: none; border-radius: 2px; }
QProgressBar::chunk { background-color: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #1a44c2, stop:1 #47bfff); border-radius: 2px; }
QScrollBar:vertical { background-color: transparent; width: 10px; }
QScrollBar:horizontal { background-color: transparent; height: 10px; }
QScrollBar::handle { border-radius: 3px; }
