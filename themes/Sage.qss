/* base-style: plastique
   icon-recolor: #2b5e3d #cfd8d0
   Generated by tools/make_themes.py
   palette: bg=#cfd8d0 panel=#c0ccc2 base=#e8eee8 alt=#d6dfd7 border=#9aab9d text=#1b261f dim=#5a645d disabled=#8b948d accent=#2f8550 accent2=#549b70 sel=#3f9461 seltext=#ffffff hover=#bdc6be button=#bccabe buttonhover=#afbdb1 buttonpress=#a9b6ab tip=#e8eee8 tiptext=#1b261f handle=#8b9b8e handlehover=#7a8a7e mark=#ffffff icons=#2b5e3d */

QWidget { background-color: #cfd8d0; color: #1b261f; selection-background-color: #3f9461; selection-color: #ffffff; }
QWidget:disabled { color: #8b948d; }
QMainWindow, QDialog { background-color: #cfd8d0; }
QMainWindow::separator { background-color: #9aab9d; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #2f8550; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #9aab9d; background-color: #9aab9d; }
QToolTip { background-color: #e8eee8; color: #1b261f; border: 1px solid #9aab9d; padding: 3px 5px; }

QMenuBar { background-color: #c0ccc2; border-bottom: 1px solid #9aab9d; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #bdc6be; }
QMenuBar::item:pressed { background-color: #3f9461; color: #ffffff; }
QMenu { background-color: #c0ccc2; border: 1px solid #9aab9d; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #3f9461; color: #ffffff; }
QMenu::item:disabled { color: #8b948d; }
QMenu::separator { height: 1px; background-color: #9aab9d; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/sage/check-dim.png); }
QMenu::right-arrow { image: url(images/sage/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #c0ccc2; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #9aab9d; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #9aab9d; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #bdc6be; border-color: #9aab9d; }
QToolButton:pressed { background-color: #a9b6ab; }
QToolButton:checked { background-color: #3f9461; border-color: #2f8550; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/sage/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #1b261f; titlebar-close-icon: url(images/sage/close.png); titlebar-normal-icon: url(images/sage/float.png); }
QDockWidget::title { background-color: #c0ccc2; padding: 4px 6px; border-bottom: 1px solid #9aab9d; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #bdc6be; border-color: #9aab9d; }
QTabWidget::pane { border: 1px solid #9aab9d; top: -1px; background-color: #cfd8d0; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #c0ccc2; color: #5a645d; border: 1px solid #9aab9d; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #cfd8d0; color: #1b261f; }
QTabBar::tab:top:selected { border-top: 2px solid #2f8550; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #2f8550; }
QTabBar::tab:hover:!selected { background-color: #bdc6be; color: #1b261f; }
QTabBar::close-button { image: url(images/sage/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/sage/close-hover.png); }
QTabBar QToolButton { background-color: #c0ccc2; border: 1px solid #9aab9d; }
QTabBar QToolButton::left-arrow { image: url(images/sage/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/sage/arrow-right.png); }

QPushButton { background-color: #bccabe; color: #1b261f; border: 1px solid #9aab9d; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #afbdb1; border-color: #2f8550; }
QPushButton:pressed { background-color: #a9b6ab; }
QPushButton:checked { background-color: #3f9461; color: #ffffff; border-color: #2f8550; }
QPushButton:default { border-color: #2f8550; }
QPushButton:disabled { color: #8b948d; background-color: #cfd8d0; border-color: #9aab9d; }
QPushButton::menu-indicator { image: url(images/sage/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #e8eee8; color: #1b261f; border: 1px solid #9aab9d; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #2f8550; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #cfd8d0; color: #8b948d; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #bccabe; border-left: 1px solid #9aab9d; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #afbdb1; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #a9b6ab; }
QAbstractSpinBox::up-arrow { image: url(images/sage/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/sage/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #bccabe; color: #1b261f; border: 1px solid #9aab9d; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #e8eee8; }
QComboBox:hover { border-color: #2f8550; }
QComboBox:on { border-color: #2f8550; }
QComboBox:disabled { color: #8b948d; background-color: #cfd8d0; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #9aab9d; }
QComboBox::down-arrow { image: url(images/sage/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #e8eee8; border: 1px solid #9aab9d; selection-background-color: #3f9461; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #e8eee8; border: 1px solid #8b9b8e; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #2f8550; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #2f8550; border-color: #2f8550; image: url(images/sage/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #2f8550; border-color: #2f8550; image: url(images/sage/partial.png); }
QRadioButton::indicator:checked { background-color: #2f8550; border-color: #2f8550; image: url(images/sage/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #cfd8d0; border-color: #9aab9d; }
QCheckBox::indicator:checked:disabled { background-color: #9aab9d; }

QGroupBox { border: 1px solid #9aab9d; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #5a645d; }

QAbstractItemView { background-color: #e8eee8; alternate-background-color: #d6dfd7; color: #1b261f; border: 1px solid #9aab9d; outline: 0; }
QAbstractItemView::item:hover { background-color: #bdc6be; }
QAbstractItemView::item:selected { background-color: #3f9461; color: #ffffff; }
QAbstractItemView:disabled { color: #8b948d; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/sage/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/sage/arrow-down.png); }
QHeaderView { background-color: #c0ccc2; }
QHeaderView::section { background-color: #c0ccc2; color: #5a645d; padding: 3px 6px; border: none; border-right: 1px solid #9aab9d; border-bottom: 1px solid #9aab9d; }
QHeaderView::section:hover { background-color: #bdc6be; color: #1b261f; }
QTableCornerButton::section { background-color: #c0ccc2; border: none; border-right: 1px solid #9aab9d; border-bottom: 1px solid #9aab9d; }

QScrollBar:vertical { background-color: #cfd8d0; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #cfd8d0; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #8b9b8e; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #7a8a7e; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #cfd8d0; }

QSlider::groove:horizontal { height: 4px; background-color: #9aab9d; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #9aab9d; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #2f8550; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #2f8550; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #1b261f; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #1b261f; }
QSlider::handle:hover { background-color: #549b70; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #e8eee8; border: 1px solid #9aab9d; border-radius: 2px; text-align: center; color: #1b261f; }
QProgressBar::chunk { background-color: #2f8550; }
QSplitter::handle { background-color: #cfd8d0; }
QSplitter::handle:hover { background-color: #2f8550; }
QStatusBar { background-color: #c0ccc2; border-top: 1px solid #9aab9d; color: #5a645d; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
