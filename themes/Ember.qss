/* base-style: plastique
   icon-recolor: #f4b25e #171614
   Generated by tools/make_themes.py
   palette: bg=#171614 panel=#201e1b base=#11100f alt=#181614 border=#34312c text=#e9e4da dim=#a09c95 disabled=#67645f accent=#e8962f accent2=#eca954 sel=#9b5b16 seltext=#ffffff hover=#2c2b28 button=#2a2723 buttonhover=#393632 buttonpress=#1e1c19 tip=#2a2825 tiptext=#e9e4da handle=#4a4641 handlehover=#615e58 mark=#000000 icons=#f4b25e */

QWidget { background-color: #171614; color: #e9e4da; selection-background-color: #9b5b16; selection-color: #ffffff; }
QWidget:disabled { color: #67645f; }
QMainWindow, QDialog { background-color: #171614; }
QMainWindow::separator { background-color: #34312c; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #e8962f; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #34312c; background-color: #34312c; }
QToolTip { background-color: #2a2825; color: #e9e4da; border: 1px solid #34312c; padding: 3px 5px; }

QMenuBar { background-color: #201e1b; border-bottom: 1px solid #34312c; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #2c2b28; }
QMenuBar::item:pressed { background-color: #9b5b16; color: #ffffff; }
QMenu { background-color: #201e1b; border: 1px solid #34312c; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #9b5b16; color: #ffffff; }
QMenu::item:disabled { color: #67645f; }
QMenu::separator { height: 1px; background-color: #34312c; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/ember/check-dim.png); }
QMenu::right-arrow { image: url(images/ember/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #201e1b; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #34312c; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #34312c; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #2c2b28; border-color: #34312c; }
QToolButton:pressed { background-color: #1e1c19; }
QToolButton:checked { background-color: #9b5b16; border-color: #e8962f; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/ember/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #e9e4da; titlebar-close-icon: url(images/ember/close.png); titlebar-normal-icon: url(images/ember/float.png); }
QDockWidget::title { background-color: #201e1b; padding: 4px 6px; border-bottom: 1px solid #34312c; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #2c2b28; border-color: #34312c; }
QTabWidget::pane { border: 1px solid #34312c; top: -1px; background-color: #171614; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #201e1b; color: #a09c95; border: 1px solid #34312c; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #171614; color: #e9e4da; }
QTabBar::tab:top:selected { border-top: 2px solid #e8962f; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #e8962f; }
QTabBar::tab:hover:!selected { background-color: #2c2b28; color: #e9e4da; }
QTabBar::close-button { image: url(images/ember/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/ember/close-hover.png); }
QTabBar QToolButton { background-color: #201e1b; border: 1px solid #34312c; }
QTabBar QToolButton::left-arrow { image: url(images/ember/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/ember/arrow-right.png); }

QPushButton { background-color: #2a2723; color: #e9e4da; border: 1px solid #34312c; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #393632; border-color: #e8962f; }
QPushButton:pressed { background-color: #1e1c19; }
QPushButton:checked { background-color: #9b5b16; color: #ffffff; border-color: #e8962f; }
QPushButton:default { border-color: #e8962f; }
QPushButton:disabled { color: #67645f; background-color: #171614; border-color: #34312c; }
QPushButton::menu-indicator { image: url(images/ember/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #11100f; color: #e9e4da; border: 1px solid #34312c; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #e8962f; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #171614; color: #67645f; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #2a2723; border-left: 1px solid #34312c; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #393632; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #1e1c19; }
QAbstractSpinBox::up-arrow { image: url(images/ember/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/ember/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #2a2723; color: #e9e4da; border: 1px solid #34312c; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #11100f; }
QComboBox:hover { border-color: #e8962f; }
QComboBox:on { border-color: #e8962f; }
QComboBox:disabled { color: #67645f; background-color: #171614; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #34312c; }
QComboBox::down-arrow { image: url(images/ember/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #11100f; border: 1px solid #34312c; selection-background-color: #9b5b16; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #11100f; border: 1px solid #4a4641; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #e8962f; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #e8962f; border-color: #e8962f; image: url(images/ember/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #e8962f; border-color: #e8962f; image: url(images/ember/partial.png); }
QRadioButton::indicator:checked { background-color: #e8962f; border-color: #e8962f; image: url(images/ember/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #171614; border-color: #34312c; }
QCheckBox::indicator:checked:disabled { background-color: #34312c; }

QGroupBox { border: 1px solid #34312c; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #a09c95; }

QAbstractItemView { background-color: #11100f; alternate-background-color: #181614; color: #e9e4da; border: 1px solid #34312c; outline: 0; }
QAbstractItemView::item:hover { background-color: #2c2b28; }
QAbstractItemView::item:selected { background-color: #9b5b16; color: #ffffff; }
QAbstractItemView:disabled { color: #67645f; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/ember/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/ember/arrow-down.png); }
QHeaderView { background-color: #201e1b; }
QHeaderView::section { background-color: #201e1b; color: #a09c95; padding: 3px 6px; border: none; border-right: 1px solid #34312c; border-bottom: 1px solid #34312c; }
QHeaderView::section:hover { background-color: #2c2b28; color: #e9e4da; }
QTableCornerButton::section { background-color: #201e1b; border: none; border-right: 1px solid #34312c; border-bottom: 1px solid #34312c; }

QScrollBar:vertical { background-color: #171614; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #171614; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #4a4641; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #615e58; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #171614; }

QSlider::groove:horizontal { height: 4px; background-color: #34312c; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #34312c; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #e8962f; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #e8962f; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #e9e4da; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #e9e4da; }
QSlider::handle:hover { background-color: #eca954; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #11100f; border: 1px solid #34312c; border-radius: 2px; text-align: center; color: #e9e4da; }
QProgressBar::chunk { background-color: #e8962f; }
QSplitter::handle { background-color: #171614; }
QSplitter::handle:hover { background-color: #e8962f; }
QStatusBar { background-color: #201e1b; border-top: 1px solid #34312c; color: #a09c95; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
