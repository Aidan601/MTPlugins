/* base-style: plastique
   icon-recolor: #8a2443 #f5e4e8
   Generated by tools/make_themes.py
   palette: bg=#f5e4e8 panel=#ecd3da base=#fff6f8 alt=#f6e6ea border=#d6aab6 text=#3a1f27 dim=#7b646b disabled=#ae999f accent=#c2335e accent2=#cd587b sel=#c94a72 seltext=#ffffff hover=#e2d0d5 button=#ecd0d8 buttonhover=#dec2ca buttonpress=#d7bbc3 tip=#fff6f8 tiptext=#3a1f27 handle=#c399a5 handlehover=#af8792 mark=#ffffff icons=#8a2443 */

QWidget { background-color: #f5e4e8; color: #3a1f27; selection-background-color: #c94a72; selection-color: #ffffff; }
QWidget:disabled { color: #ae999f; }
QMainWindow, QDialog { background-color: #f5e4e8; }
QMainWindow::separator { background-color: #d6aab6; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #c2335e; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #d6aab6; background-color: #d6aab6; }
QToolTip { background-color: #fff6f8; color: #3a1f27; border: 1px solid #d6aab6; padding: 3px 5px; }

QMenuBar { background-color: #ecd3da; border-bottom: 1px solid #d6aab6; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #e2d0d5; }
QMenuBar::item:pressed { background-color: #c94a72; color: #ffffff; }
QMenu { background-color: #ecd3da; border: 1px solid #d6aab6; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #c94a72; color: #ffffff; }
QMenu::item:disabled { color: #ae999f; }
QMenu::separator { height: 1px; background-color: #d6aab6; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/rose/check-dim.png); }
QMenu::right-arrow { image: url(images/rose/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #ecd3da; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #d6aab6; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #d6aab6; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #e2d0d5; border-color: #d6aab6; }
QToolButton:pressed { background-color: #d7bbc3; }
QToolButton:checked { background-color: #c94a72; border-color: #c2335e; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/rose/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #3a1f27; titlebar-close-icon: url(images/rose/close.png); titlebar-normal-icon: url(images/rose/float.png); }
QDockWidget::title { background-color: #ecd3da; padding: 4px 6px; border-bottom: 1px solid #d6aab6; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #e2d0d5; border-color: #d6aab6; }
QTabWidget::pane { border: 1px solid #d6aab6; top: -1px; background-color: #f5e4e8; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #ecd3da; color: #7b646b; border: 1px solid #d6aab6; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #f5e4e8; color: #3a1f27; }
QTabBar::tab:top:selected { border-top: 2px solid #c2335e; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #c2335e; }
QTabBar::tab:hover:!selected { background-color: #e2d0d5; color: #3a1f27; }
QTabBar::close-button { image: url(images/rose/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/rose/close-hover.png); }
QTabBar QToolButton { background-color: #ecd3da; border: 1px solid #d6aab6; }
QTabBar QToolButton::left-arrow { image: url(images/rose/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/rose/arrow-right.png); }

QPushButton { background-color: #ecd0d8; color: #3a1f27; border: 1px solid #d6aab6; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #dec2ca; border-color: #c2335e; }
QPushButton:pressed { background-color: #d7bbc3; }
QPushButton:checked { background-color: #c94a72; color: #ffffff; border-color: #c2335e; }
QPushButton:default { border-color: #c2335e; }
QPushButton:disabled { color: #ae999f; background-color: #f5e4e8; border-color: #d6aab6; }
QPushButton::menu-indicator { image: url(images/rose/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #fff6f8; color: #3a1f27; border: 1px solid #d6aab6; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #c2335e; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #f5e4e8; color: #ae999f; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #ecd0d8; border-left: 1px solid #d6aab6; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #dec2ca; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #d7bbc3; }
QAbstractSpinBox::up-arrow { image: url(images/rose/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/rose/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #ecd0d8; color: #3a1f27; border: 1px solid #d6aab6; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #fff6f8; }
QComboBox:hover { border-color: #c2335e; }
QComboBox:on { border-color: #c2335e; }
QComboBox:disabled { color: #ae999f; background-color: #f5e4e8; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #d6aab6; }
QComboBox::down-arrow { image: url(images/rose/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #fff6f8; border: 1px solid #d6aab6; selection-background-color: #c94a72; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #fff6f8; border: 1px solid #c399a5; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #c2335e; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #c2335e; border-color: #c2335e; image: url(images/rose/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #c2335e; border-color: #c2335e; image: url(images/rose/partial.png); }
QRadioButton::indicator:checked { background-color: #c2335e; border-color: #c2335e; image: url(images/rose/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #f5e4e8; border-color: #d6aab6; }
QCheckBox::indicator:checked:disabled { background-color: #d6aab6; }

QGroupBox { border: 1px solid #d6aab6; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #7b646b; }

QAbstractItemView { background-color: #fff6f8; alternate-background-color: #f6e6ea; color: #3a1f27; border: 1px solid #d6aab6; outline: 0; }
QAbstractItemView::item:hover { background-color: #e2d0d5; }
QAbstractItemView::item:selected { background-color: #c94a72; color: #ffffff; }
QAbstractItemView:disabled { color: #ae999f; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/rose/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/rose/arrow-down.png); }
QHeaderView { background-color: #ecd3da; }
QHeaderView::section { background-color: #ecd3da; color: #7b646b; padding: 3px 6px; border: none; border-right: 1px solid #d6aab6; border-bottom: 1px solid #d6aab6; }
QHeaderView::section:hover { background-color: #e2d0d5; color: #3a1f27; }
QTableCornerButton::section { background-color: #ecd3da; border: none; border-right: 1px solid #d6aab6; border-bottom: 1px solid #d6aab6; }

QScrollBar:vertical { background-color: #f5e4e8; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #f5e4e8; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #c399a5; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #af8792; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #f5e4e8; }

QSlider::groove:horizontal { height: 4px; background-color: #d6aab6; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #d6aab6; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #c2335e; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #c2335e; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #3a1f27; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #3a1f27; }
QSlider::handle:hover { background-color: #cd587b; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #fff6f8; border: 1px solid #d6aab6; border-radius: 2px; text-align: center; color: #3a1f27; }
QProgressBar::chunk { background-color: #c2335e; }
QSplitter::handle { background-color: #f5e4e8; }
QSplitter::handle:hover { background-color: #c2335e; }
QStatusBar { background-color: #ecd3da; border-top: 1px solid #d6aab6; color: #7b646b; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
