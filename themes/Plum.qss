/* base-style: plastique
   icon-recolor: #e2a8f0 #221726
   Generated by tools/make_themes.py
   palette: bg=#221726 panel=#2c1e31 base=#1a111d alt=#221726 border=#47324e text=#eadff0 dim=#a499a9 disabled=#6e6373 accent=#d966c4 accent2=#e082cf sel=#8a3a7d seltext=#ffffff hover=#362b3a button=#35253b buttonhover=#433449 buttonpress=#281b2c tip=#36283b tiptext=#eadff0 handle=#5b4761 handlehover=#705d76 mark=#ffffff icons=#e2a8f0 */

QWidget { background-color: #221726; color: #eadff0; selection-background-color: #8a3a7d; selection-color: #ffffff; }
QWidget:disabled { color: #6e6373; }
QMainWindow, QDialog { background-color: #221726; }
QMainWindow::separator { background-color: #47324e; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #d966c4; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #47324e; background-color: #47324e; }
QToolTip { background-color: #36283b; color: #eadff0; border: 1px solid #47324e; padding: 3px 5px; }

QMenuBar { background-color: #2c1e31; border-bottom: 1px solid #47324e; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #362b3a; }
QMenuBar::item:pressed { background-color: #8a3a7d; color: #ffffff; }
QMenu { background-color: #2c1e31; border: 1px solid #47324e; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #8a3a7d; color: #ffffff; }
QMenu::item:disabled { color: #6e6373; }
QMenu::separator { height: 1px; background-color: #47324e; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/plum/check-dim.png); }
QMenu::right-arrow { image: url(images/plum/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #2c1e31; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #47324e; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #47324e; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #362b3a; border-color: #47324e; }
QToolButton:pressed { background-color: #281b2c; }
QToolButton:checked { background-color: #8a3a7d; border-color: #d966c4; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/plum/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #eadff0; titlebar-close-icon: url(images/plum/close.png); titlebar-normal-icon: url(images/plum/float.png); }
QDockWidget::title { background-color: #2c1e31; padding: 4px 6px; border-bottom: 1px solid #47324e; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #362b3a; border-color: #47324e; }
QTabWidget::pane { border: 1px solid #47324e; top: -1px; background-color: #221726; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #2c1e31; color: #a499a9; border: 1px solid #47324e; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #221726; color: #eadff0; }
QTabBar::tab:top:selected { border-top: 2px solid #d966c4; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #d966c4; }
QTabBar::tab:hover:!selected { background-color: #362b3a; color: #eadff0; }
QTabBar::close-button { image: url(images/plum/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/plum/close-hover.png); }
QTabBar QToolButton { background-color: #2c1e31; border: 1px solid #47324e; }
QTabBar QToolButton::left-arrow { image: url(images/plum/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/plum/arrow-right.png); }

QPushButton { background-color: #35253b; color: #eadff0; border: 1px solid #47324e; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #433449; border-color: #d966c4; }
QPushButton:pressed { background-color: #281b2c; }
QPushButton:checked { background-color: #8a3a7d; color: #ffffff; border-color: #d966c4; }
QPushButton:default { border-color: #d966c4; }
QPushButton:disabled { color: #6e6373; background-color: #221726; border-color: #47324e; }
QPushButton::menu-indicator { image: url(images/plum/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #1a111d; color: #eadff0; border: 1px solid #47324e; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #d966c4; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #221726; color: #6e6373; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #35253b; border-left: 1px solid #47324e; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #433449; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #281b2c; }
QAbstractSpinBox::up-arrow { image: url(images/plum/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/plum/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #35253b; color: #eadff0; border: 1px solid #47324e; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #1a111d; }
QComboBox:hover { border-color: #d966c4; }
QComboBox:on { border-color: #d966c4; }
QComboBox:disabled { color: #6e6373; background-color: #221726; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #47324e; }
QComboBox::down-arrow { image: url(images/plum/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #1a111d; border: 1px solid #47324e; selection-background-color: #8a3a7d; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #1a111d; border: 1px solid #5b4761; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #d966c4; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #d966c4; border-color: #d966c4; image: url(images/plum/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #d966c4; border-color: #d966c4; image: url(images/plum/partial.png); }
QRadioButton::indicator:checked { background-color: #d966c4; border-color: #d966c4; image: url(images/plum/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #221726; border-color: #47324e; }
QCheckBox::indicator:checked:disabled { background-color: #47324e; }

QGroupBox { border: 1px solid #47324e; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #a499a9; }

QAbstractItemView { background-color: #1a111d; alternate-background-color: #221726; color: #eadff0; border: 1px solid #47324e; outline: 0; }
QAbstractItemView::item:hover { background-color: #362b3a; }
QAbstractItemView::item:selected { background-color: #8a3a7d; color: #ffffff; }
QAbstractItemView:disabled { color: #6e6373; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/plum/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/plum/arrow-down.png); }
QHeaderView { background-color: #2c1e31; }
QHeaderView::section { background-color: #2c1e31; color: #a499a9; padding: 3px 6px; border: none; border-right: 1px solid #47324e; border-bottom: 1px solid #47324e; }
QHeaderView::section:hover { background-color: #362b3a; color: #eadff0; }
QTableCornerButton::section { background-color: #2c1e31; border: none; border-right: 1px solid #47324e; border-bottom: 1px solid #47324e; }

QScrollBar:vertical { background-color: #221726; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #221726; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #5b4761; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #705d76; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #221726; }

QSlider::groove:horizontal { height: 4px; background-color: #47324e; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #47324e; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #d966c4; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #d966c4; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #eadff0; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #eadff0; }
QSlider::handle:hover { background-color: #e082cf; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #1a111d; border: 1px solid #47324e; border-radius: 2px; text-align: center; color: #eadff0; }
QProgressBar::chunk { background-color: #d966c4; }
QSplitter::handle { background-color: #221726; }
QSplitter::handle:hover { background-color: #d966c4; }
QStatusBar { background-color: #2c1e31; border-top: 1px solid #47324e; color: #a499a9; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
