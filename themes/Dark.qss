/* base-style: plastique
   icon-recolor: #8fbcf2 #202225
   Generated by tools/make_themes.py
   palette: bg=#202225 panel=#2a2c30 base=#1a1b1e alt=#222428 border=#3a3d42 text=#dcdde0 dim=#9a9ea6 disabled=#62666d accent=#3b8eea accent2=#5aa2f0 sel=#2f6db5 seltext=#ffffff hover=#33363b button=#33363b buttonhover=#3d4046 buttonpress=#26282c tip=#2f3237 tiptext=#ececec handle=#4a4e55 handlehover=#5d626a mark=#ffffff icons=#8fbcf2 */

QWidget { background-color: #202225; color: #dcdde0; selection-background-color: #2f6db5; selection-color: #ffffff; }
QWidget:disabled { color: #62666d; }
QMainWindow, QDialog { background-color: #202225; }
QMainWindow::separator { background-color: #3a3d42; width: 3px; height: 3px; }
QMainWindow::separator:hover { background-color: #3b8eea; }
QLabel, QCheckBox, QRadioButton { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #3a3d42; background-color: #3a3d42; }
QToolTip { background-color: #2f3237; color: #ececec; border: 1px solid #3a3d42; padding: 3px 5px; }

QMenuBar { background-color: #2a2c30; border-bottom: 1px solid #3a3d42; }
QMenuBar::item { background: transparent; padding: 4px 9px; }
QMenuBar::item:selected { background-color: #33363b; }
QMenuBar::item:pressed { background-color: #2f6db5; color: #ffffff; }
QMenu { background-color: #2a2c30; border: 1px solid #3a3d42; padding: 3px 0px; }
QMenu::item { background: transparent; padding: 4px 22px 4px 26px; }
QMenu::item:selected { background-color: #2f6db5; color: #ffffff; }
QMenu::item:disabled { color: #62666d; }
QMenu::separator { height: 1px; background-color: #3a3d42; margin: 4px 8px; }
QMenu::indicator { width: 13px; height: 13px; left: 6px; }
QMenu::indicator:checked { image: url(images/dark/check-dim.png); }
QMenu::right-arrow { image: url(images/dark/arrow-right.png); width: 10px; height: 10px; }

QToolBar { background-color: #2a2c30; border: none; spacing: 2px; padding: 2px; }
QToolBar::separator { background-color: #3a3d42; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background-color: #3a3d42; width: 3px; height: 3px; margin: 3px; }
QToolButton { background-color: transparent; border: 1px solid transparent; border-radius: 3px; padding: 2px; }
QToolButton:hover { background-color: #33363b; border-color: #3a3d42; }
QToolButton:pressed { background-color: #26282c; }
QToolButton:checked { background-color: #2f6db5; border-color: #3b8eea; color: #ffffff; }
QToolButton::menu-indicator { image: url(images/dark/arrow-down.png); width: 8px; height: 8px; subcontrol-position: bottom right; subcontrol-origin: padding; }

QDockWidget { color: #dcdde0; titlebar-close-icon: url(images/dark/close.png); titlebar-normal-icon: url(images/dark/float.png); }
QDockWidget::title { background-color: #2a2c30; padding: 4px 6px; border-bottom: 1px solid #3a3d42; text-align: left; }
QDockWidget::close-button, QDockWidget::float-button { background: transparent; border: 1px solid transparent; border-radius: 2px; padding: 1px; }
QDockWidget::close-button:hover, QDockWidget::float-button:hover { background-color: #33363b; border-color: #3a3d42; }
QTabWidget::pane { border: 1px solid #3a3d42; top: -1px; background-color: #202225; }
QTabBar { background: transparent; }
QTabBar::tab { background-color: #2a2c30; color: #9a9ea6; border: 1px solid #3a3d42; padding: 4px 10px; }
QTabBar::tab:top { border-bottom: none; margin-right: 1px; border-top-left-radius: 3px; border-top-right-radius: 3px; }
QTabBar::tab:bottom { border-top: none; margin-right: 1px; border-bottom-left-radius: 3px; border-bottom-right-radius: 3px; }
QTabBar::tab:selected { background-color: #202225; color: #dcdde0; }
QTabBar::tab:top:selected { border-top: 2px solid #3b8eea; }
QTabBar::tab:bottom:selected { border-bottom: 2px solid #3b8eea; }
QTabBar::tab:hover:!selected { background-color: #33363b; color: #dcdde0; }
QTabBar::close-button { image: url(images/dark/close.png); subcontrol-position: right; }
QTabBar::close-button:hover { image: url(images/dark/close-hover.png); }
QTabBar QToolButton { background-color: #2a2c30; border: 1px solid #3a3d42; }
QTabBar QToolButton::left-arrow { image: url(images/dark/arrow-left.png); }
QTabBar QToolButton::right-arrow { image: url(images/dark/arrow-right.png); }

QPushButton { background-color: #33363b; color: #dcdde0; border: 1px solid #3a3d42; border-radius: 3px; padding: 3px 12px; }
QPushButton:hover { background-color: #3d4046; border-color: #3b8eea; }
QPushButton:pressed { background-color: #26282c; }
QPushButton:checked { background-color: #2f6db5; color: #ffffff; border-color: #3b8eea; }
QPushButton:default { border-color: #3b8eea; }
QPushButton:disabled { color: #62666d; background-color: #202225; border-color: #3a3d42; }
QPushButton::menu-indicator { image: url(images/dark/arrow-down.png); width: 8px; height: 8px; subcontrol-position: right center; subcontrol-origin: padding; right: 4px; }

QLineEdit, QTextEdit, QPlainTextEdit, QAbstractSpinBox { background-color: #1a1b1e; color: #dcdde0; border: 1px solid #3a3d42; border-radius: 2px; }
QLineEdit { padding: 2px 4px; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QAbstractSpinBox:focus { border-color: #3b8eea; }
QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled, QAbstractSpinBox:disabled { background-color: #202225; color: #62666d; }
QAbstractSpinBox { padding: 1px 18px 1px 4px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { subcontrol-origin: border; width: 16px; background-color: #33363b; border-left: 1px solid #3a3d42; }
QAbstractSpinBox::up-button { subcontrol-position: top right; border-top-right-radius: 2px; }
QAbstractSpinBox::down-button { subcontrol-position: bottom right; border-bottom-right-radius: 2px; }
QAbstractSpinBox::up-button:hover, QAbstractSpinBox::down-button:hover { background-color: #3d4046; }
QAbstractSpinBox::up-button:pressed, QAbstractSpinBox::down-button:pressed { background-color: #26282c; }
QAbstractSpinBox::up-arrow { image: url(images/dark/arrow-up.png); width: 8px; height: 8px; }
QAbstractSpinBox::down-arrow { image: url(images/dark/arrow-down.png); width: 8px; height: 8px; }

QComboBox { background-color: #33363b; color: #dcdde0; border: 1px solid #3a3d42; border-radius: 2px; padding: 2px 22px 2px 6px; }
QComboBox:editable { background-color: #1a1b1e; }
QComboBox:hover { border-color: #3b8eea; }
QComboBox:on { border-color: #3b8eea; }
QComboBox:disabled { color: #62666d; background-color: #202225; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 18px; border-left: 1px solid #3a3d42; }
QComboBox::down-arrow { image: url(images/dark/arrow-down.png); width: 10px; height: 10px; }
QComboBox QAbstractItemView { background-color: #1a1b1e; border: 1px solid #3a3d42; selection-background-color: #2f6db5; selection-color: #ffffff; outline: 0; }
QComboBox { combobox-popup: 0; }
QComboBox#compareOP { padding: 2px 2px 2px 4px; }
QComboBox#compareOP::drop-down { width: 14px; }

QCheckBox, QRadioButton { spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator, QAbstractItemView::indicator { width: 13px; height: 13px; background-color: #1a1b1e; border: 1px solid #4a4e55; }
QCheckBox::indicator, QAbstractItemView::indicator { border-radius: 2px; }
QRadioButton::indicator { border-radius: 7px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover, QAbstractItemView::indicator:hover { border-color: #3b8eea; }
QCheckBox::indicator:checked, QAbstractItemView::indicator:checked { background-color: #3b8eea; border-color: #3b8eea; image: url(images/dark/check.png); }
QCheckBox::indicator:indeterminate, QAbstractItemView::indicator:indeterminate { background-color: #3b8eea; border-color: #3b8eea; image: url(images/dark/partial.png); }
QRadioButton::indicator:checked { background-color: #3b8eea; border-color: #3b8eea; image: url(images/dark/radio.png); }
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled { background-color: #202225; border-color: #3a3d42; }
QCheckBox::indicator:checked:disabled { background-color: #3a3d42; }

QGroupBox { border: 1px solid #3a3d42; border-radius: 3px; margin-top: 14px; padding-top: 4px; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 8px; padding: 0px 4px; color: #9a9ea6; }

QAbstractItemView { background-color: #1a1b1e; alternate-background-color: #222428; color: #dcdde0; border: 1px solid #3a3d42; outline: 0; }
QAbstractItemView::item:hover { background-color: #33363b; }
QAbstractItemView::item:selected { background-color: #2f6db5; color: #ffffff; }
QAbstractItemView:disabled { color: #62666d; }
QTreeView::branch { background: transparent; }
QTreeView::branch:has-children:!has-siblings:closed, QTreeView::branch:closed:has-children:has-siblings { border-image: none; image: url(images/dark/arrow-right.png); }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { border-image: none; image: url(images/dark/arrow-down.png); }
QHeaderView { background-color: #2a2c30; }
QHeaderView::section { background-color: #2a2c30; color: #9a9ea6; padding: 3px 6px; border: none; border-right: 1px solid #3a3d42; border-bottom: 1px solid #3a3d42; }
QHeaderView::section:hover { background-color: #33363b; color: #dcdde0; }
QTableCornerButton::section { background-color: #2a2c30; border: none; border-right: 1px solid #3a3d42; border-bottom: 1px solid #3a3d42; }

QScrollBar:vertical { background-color: #202225; width: 12px; margin: 0px; }
QScrollBar:horizontal { background-color: #202225; height: 12px; margin: 0px; }
QScrollBar::handle { background-color: #4a4e55; border-radius: 4px; }
QScrollBar::handle:vertical { min-height: 24px; margin: 2px 2px; }
QScrollBar::handle:horizontal { min-width: 24px; margin: 2px 2px; }
QScrollBar::handle:hover { background-color: #5d626a; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; background: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QAbstractScrollArea::corner { background-color: #202225; }

QSlider::groove:horizontal { height: 4px; background-color: #3a3d42; border-radius: 2px; }
QSlider::groove:vertical { width: 4px; background-color: #3a3d42; border-radius: 2px; }
QSlider::sub-page:horizontal { background-color: #3b8eea; border-radius: 2px; }
QSlider::add-page:vertical { background-color: #3b8eea; border-radius: 2px; }
QSlider::handle:horizontal { width: 12px; margin: -5px 0px; border-radius: 6px; background-color: #dcdde0; }
QSlider::handle:vertical { height: 12px; margin: 0px -5px; border-radius: 6px; background-color: #dcdde0; }
QSlider::handle:hover { background-color: #5aa2f0; }
QSlider[styleSheet~="QSlider::groove:horizontal"]::sub-page:horizontal, QSlider[styleSheet~="QSlider::groove:horizontal"]::add-page:horizontal { background: transparent; }
QProgressBar { background-color: #1a1b1e; border: 1px solid #3a3d42; border-radius: 2px; text-align: center; color: #dcdde0; }
QProgressBar::chunk { background-color: #3b8eea; }
QSplitter::handle { background-color: #202225; }
QSplitter::handle:hover { background-color: #3b8eea; }
QStatusBar { background-color: #2a2c30; border-top: 1px solid #3a3d42; color: #9a9ea6; }
QStatusBar::item { border: none; }
QSizeGrip { background: transparent; }
